---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/index.js";
import { eventos } from "../../db/schema.js";
import { desc } from "drizzle-orm";

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

const listaEventos = await db
  .select()
  .from(eventos)
  .orderBy(desc(eventos.fecha));
---

<AdminLayout title="Eventos | Panel">
  <section style="padding: 3rem 0;">
    <div class="container">
      <div class="admin-page-header">
        <div>
          <h1 class="admin-page-title">Eventos</h1>
          <p class="admin-page-subtitle">
            Gestioná las próximas presentaciones del grupo.
          </p>
        </div>
        <div class="admin-header-actions">
          <a href="/admin/ayuda" class="admin-link-btn">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            Ayuda
          </a>
          <a href="/admin/eventos/nuevo" class="btn">+ Nuevo evento</a>
        </div>
      </div>

      {
        listaEventos.length === 0 ? (
          <div
            class="admin-card"
            style="text-align: center; padding: 3rem 1.5rem;"
          >
            <p style="color: var(--text-muted); margin-bottom: 1rem;">
              No hay eventos cargados todavía.
            </p>
            <a href="/admin/eventos/nuevo" class="btn">
              Crear el primero
            </a>
          </div>
        ) : (
          <div class="eventos-grid">
            {listaEventos.map((ev) => (
              <div class="admin-card evento-card">
                <div class="evento-card-imagen">
                  {ev.imagenUrl ? (
                    <img src={ev.imagenUrl} alt={ev.titulo} loading="lazy" />
                  ) : (
                    <div class="evento-card-imagen-placeholder">
                      <svg
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <rect
                          x="3"
                          y="3"
                          width="18"
                          height="18"
                          rx="2"
                          ry="2"
                        />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="M21 15l-5-5L5 21" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="evento-card-fecha">
                  <span class="evento-card-dia">
                    {new Date(ev.fecha).getDate()}
                  </span>
                  <span class="evento-card-mes">
                    {new Date(ev.fecha).toLocaleDateString("es-AR", {
                      month: "short",
                    })}
                  </span>
                </div>
                <div class="evento-card-info">
                  <h3>{ev.titulo}</h3>
                  <p>
                    {ev.lugar}
                    {ev.hora ? ` · ${ev.hora}` : ""}
                  </p>
                  <p class="evento-card-fecha-completa">
                    {new Date(ev.fecha).toLocaleDateString("es-AR", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                  </p>
                </div>
                <div class="evento-card-actions">
                  <a href={`/admin/eventos/${ev.id}`} class="admin-link-btn">
                    Editar
                  </a>
                  <button
                    type="button"
                    class="admin-link-btn danger delete-btn"
                    data-id={ev.id}
                    data-titulo={ev.titulo}
                  >
                    Eliminar
                  </button>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <script>
    // @ts-nocheck
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const titulo = btn.getAttribute("data-titulo") || "este evento";
        const ok = await window.confirmDialog(
          `¿Eliminar "${titulo}"? No se podrá recuperar.`,
          { title: "Eliminar evento", okText: "Sí, eliminar" },
        );
        if (!ok) return;

        const id = btn.getAttribute("data-id");
        try {
          const res = await fetch(`/api/eventos/${id}`, {
            method: "DELETE",
            credentials: "include",
          });
          if (res.ok) {
            window.showToast("Evento eliminado", "success");
            setTimeout(() => window.location.reload(), 800);
          } else {
            window.showToast("Error al eliminar", "error");
          }
        } catch (err) {
          window.showToast("Error de conexión", "error");
        }
      });
    });
  </script>

  <style>
    .admin-page-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }
    .admin-header-actions {
      display: flex;
      gap: 0.8rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .admin-link-btn svg {
      display: inline-block;
      vertical-align: middle;
      margin-right: 0.4rem;
    }
    .eventos-grid {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .evento-card {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 1rem 1.5rem;
      transition: border-color 0.2s ease;
    }
    .evento-card-imagen {
      width: 80px;
      height: 80px;
      flex-shrink: 0;
      border-radius: 4px;
      overflow: hidden;
      background: rgba(255, 202, 40, 0.06);
      border: 1px solid rgba(255, 202, 40, 0.15);
    }
    .evento-card-imagen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .evento-card:hover .evento-card-imagen img {
      transform: scale(1.05);
    }
    .evento-card:hover .evento-card-imagen {
      border-color: rgba(233, 30, 99, 0.5);
      box-shadow: 0 0 15px rgba(233, 30, 99, 0.2);
    }
    .evento-card-imagen-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      opacity: 0.4;
    }
    .evento-card-fecha {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 55px;
      flex-shrink: 0;
    }
    .evento-card-dia {
      font-family: var(--font-serif);
      font-size: 2rem;
      line-height: 1;
      color: var(--accent-soft);
    }
    .evento-card-mes {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
    }
    .evento-card-info {
      flex: 1;
      min-width: 0;
    }
    .evento-card-info h3 {
      margin-bottom: 0.2rem;
      font-size: 1.1rem;
    }
    .evento-card-info p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0;
    }
    .evento-card-fecha-completa {
      font-size: 0.8rem !important;
      opacity: 0.7;
    }
    .evento-card-actions {
      display: flex;
      gap: 0.3rem;
      flex-shrink: 0;
    }
    @media (max-width: 640px) {
      .evento-card {
        flex-wrap: wrap;
        gap: 1rem;
      }
      .evento-card-imagen {
        width: 64px;
        height: 64px;
      }
      .evento-card-actions {
        width: 100%;
        justify-content: flex-end;
      }
    }
  </style>
</AdminLayout>
