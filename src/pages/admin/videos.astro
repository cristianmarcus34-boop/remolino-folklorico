---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/index.js";
import { videos } from "../../db/schema.js";
import { desc } from "drizzle-orm";

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
    return Astro.redirect("/login");
}

const listaVideos = await db.select().from(videos).orderBy(desc(videos.id));

const getYouTubeId = (url: string): string | null => {
    if (!url) return null;
    const match = url.match(
        /(?:youtube\.com\/watch\?v=|music\.youtube\.com\/watch\?v=|youtube\.com\/shorts\/|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
    );
    return match ? match[1] : null;
};

const esVideoSubido = (url: string): boolean => {
    return url.includes(".public.blob.vercel-storage.com");
};
---

<AdminLayout title="Videos | Panel">
    <section style="padding: 3rem 0;">
        <div class="container">
            <div class="admin-page-header">
                <div>
                    <h1 class="admin-page-title">Videos</h1>
                    <p class="admin-page-subtitle">
                        Subí videos desde tu dispositivo o agregá URLs de
                        YouTube.
                    </p>
                </div>
            </div>

            <div class="admin-card" style="margin-bottom: 2.5rem;">
                <form id="video-form">
                    <div class="admin-field">
                        <label class="admin-label" for="titulo">Título *</label>
                        <input
                            id="titulo"
                            type="text"
                            name="titulo"
                            required
                            class="admin-input"
                            placeholder="Ej: Presentación en el Teatro Provincial"
                        />
                    </div>

                    <div class="admin-field">
                        <label class="admin-label">Origen del video</label>
                        <div class="imagen-tabs">
                            <button
                                type="button"
                                class="imagen-tab active"
                                data-tab="archivo">Subir archivo</button
                            >
                            <button
                                type="button"
                                class="imagen-tab"
                                data-tab="youtube">URL de YouTube</button
                            >
                        </div>

                        <div class="imagen-panel active" data-panel="archivo">
                            <input
                                type="file"
                                id="videoFile"
                                accept="video/mp4,video/webm,video/ogg"
                                class="admin-input"
                                style="padding: 0.5rem;"
                            />
                            <p
                                style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;"
                            >
                                MP4, WebM u OGG · máx 500 MB.
                            </p>
                            <div
                                id="preview-container"
                                style="display: none; margin-top: 0.8rem;"
                            >
                                <video
                                    id="preview"
                                    controls
                                    style="max-width: 100%; max-height: 200px; border-radius: 4px; border: 1px solid rgba(255, 202, 40, 0.3);"
                                ></video>
                            </div>
                        </div>

                        <div class="imagen-panel" data-panel="youtube">
                            <input
                                id="url"
                                type="url"
                                name="url"
                                class="admin-input"
                                placeholder="https://www.youtube.com/watch?v=..."
                            />
                            <p
                                style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;"
                            >
                                Pegá la URL del video de YouTube (watch, shorts,
                                youtu.be o YouTube Music).
                            </p>
                        </div>
                    </div>

                    <div class="admin-field">
                        <label class="admin-label" for="descripcion"
                            >Descripción</label
                        >
                        <textarea
                            id="descripcion"
                            name="descripcion"
                            rows="2"
                            class="admin-input"
                            placeholder="Breve descripción del video (opcional)"
                        ></textarea>
                    </div>

                    <div class="admin-actions">
                        <button type="submit" class="btn" id="submit-btn"
                            >Agregar video</button
                        >
                        <span
                            id="status-msg"
                            style="font-size: 0.85rem; color: var(--text-muted);"
                        ></span>
                    </div>
                    <p
                        id="error-msg"
                        class="admin-msg error"
                        style="display: none;"
                    >
                    </p>
                </form>
            </div>

            <h2 style="font-size: 1.2rem; margin-bottom: 1rem;">
                Videos cargados ({listaVideos.length})
            </h2>

            {
                listaVideos.length === 0 ? (
                    <p style="color: var(--text-muted);">
                        No hay videos cargados todavía.
                    </p>
                ) : (
                    <div class="videos-grid">
                        {listaVideos.map((video) => {
                            const videoId = getYouTubeId(video.url);
                            const esSubido = esVideoSubido(video.url);
                            return (
                                <div class="video-item">
                                    <div class="video-preview">
                                        {esSubido ? (
                                            <video
                                                controls
                                                style="width: 100%; height: 100%; display: block;"
                                            >
                                                <source
                                                    src={video.url}
                                                    type="video/mp4"
                                                />
                                            </video>
                                        ) : videoId ? (
                                            <iframe
                                                src={`https://www.youtube.com/embed/${videoId}`}
                                                title={video.titulo}
                                                frameborder="0"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="video-invalid">
                                                URL inválida
                                            </div>
                                        )}
                                    </div>
                                    <div class="video-info">
                                        <h3>{video.titulo}</h3>
                                        {video.descripcion && (
                                            <p>{video.descripcion}</p>
                                        )}
                                        <button
                                            type="button"
                                            class="admin-link-btn danger delete-video-btn"
                                            data-id={video.id}
                                        >
                                            Eliminar
                                        </button>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )
            }
        </div>
    </section>

    <style>
        .imagen-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
        }
        .imagen-tab {
            background: none;
            border: 1px solid rgba(233, 30, 99, 0.3); /* Borde fucsia */
            color: var(--text-muted);
            padding: 0.4rem 0.9rem;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .imagen-tab:hover {
            border-color: var(--accent-soft);
            color: var(--accent-soft);
        }
        .imagen-tab.active {
            background: rgba(233, 30, 99, 0.15); /* Fondo fucsia */
            border-color: var(--accent);
            color: var(--accent);
        }
        .imagen-panel {
            display: none;
        }
        .imagen-panel.active {
            display: block;
        }
        .videos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }
        .video-item {
            background: var(--bg-soft);
            border: 1px solid rgba(255, 202, 40, 0.12); /* Borde dorado sutil */
            border-radius: 4px;
            overflow: hidden;
            transition:
                border-color 0.2s,
                transform 0.2s,
                box-shadow 0.2s;
        }
        .video-item:hover {
            border-color: rgba(255, 202, 40, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(233, 30, 99, 0.15); /* Resplandor fucsia */
        }
        .video-preview {
            position: relative;
            aspect-ratio: 16 / 9;
            background: #000;
        }
        .video-preview iframe,
        .video-preview video {
            width: 100%;
            height: 100%;
            display: block;
        }
        .video-invalid {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e74c3c;
            font-size: 0.85rem;
        }
        .video-info {
            padding: 1rem;
        }
        .video-info h3 {
            font-size: 1rem;
            margin-bottom: 0.3rem;
        }
        .video-info p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 0.8rem;
        }
    </style>

    <script>
        // @ts-nocheck
        import { upload } from "@vercel/blob/client";

        const form = document.getElementById("video-form");
        const errorMsg = document.getElementById("error-msg");
        const submitBtn = document.getElementById("submit-btn");
        const videoFile = document.getElementById("videoFile");
        const preview = document.getElementById("preview");
        const previewContainer = document.getElementById("preview-container");
        const urlInput = document.getElementById("url");

        // Tabs
        const tabs = document.querySelectorAll(".imagen-tab");
        const panels = document.querySelectorAll(".imagen-panel");
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.getAttribute("data-tab");
                tabs.forEach((t) => t.classList.remove("active"));
                tab.classList.add("active");
                panels.forEach((p) => {
                    p.classList.toggle(
                        "active",
                        p.getAttribute("data-panel") === target,
                    );
                });
            });
        });

        // Preview de video
        if (videoFile && "files" in videoFile) {
            videoFile.addEventListener("change", () => {
                const files = videoFile.files;
                if (
                    !files ||
                    typeof files !== "object" ||
                    !("length" in files)
                ) {
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "none";
                    }
                    return;
                }
                const filesArray = Array.from(files);
                const file = filesArray.length > 0 ? filesArray[0] : null;
                if (!file) {
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "none";
                    }
                    return;
                }
                const reader = new FileReader();
                reader.onload = (e) => {
                    if (preview && "src" in preview) {
                        preview.src = String(e.target ? e.target.result : "");
                    }
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "block";
                    }
                };
                reader.readAsDataURL(file);
            });
        }

        if (form && errorMsg && submitBtn) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                submitBtn.setAttribute("disabled", "true");
                submitBtn.textContent = "Guardando...";

                const elTitulo = document.getElementById("titulo");
                const elDescripcion = document.getElementById("descripcion");
                const titulo =
                    elTitulo && "value" in elTitulo ? elTitulo.value : "";
                const descripcion =
                    elDescripcion && "value" in elDescripcion
                        ? elDescripcion.value
                        : "";

                const panelActivo = document.querySelector(
                    ".imagen-panel.active",
                );
                const archivoActivo =
                    panelActivo?.getAttribute("data-panel") === "archivo";
                let url = urlInput && "value" in urlInput ? urlInput.value : "";

                try {
                    if (
                        archivoActivo &&
                        videoFile &&
                        "files" in videoFile &&
                        videoFile.files &&
                        typeof videoFile.files === "object" &&
                        "length" in videoFile.files &&
                        videoFile.files.length > 0
                    ) {
                        const filesArray = Array.from(videoFile.files);
                        const file = filesArray[0];
                        submitBtn.textContent = "Subiendo video...";

                        const blob = await upload(file.name, file, {
                            access: "public",
                            handleUploadUrl: "/api/videos/upload-token",
                        });

                        url = blob.url;
                    }

                    if (!url) {
                        errorMsg.textContent =
                            "Seleccioná un archivo o pegá una URL de YouTube.";
                        errorMsg.style.display = "block";
                        return;
                    }

                    const res = await fetch("/api/videos", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ titulo, url, descripcion }),
                    });

                    if (res.ok) {
                        window.location.reload();
                    } else {
                        const data = await res.json();
                        errorMsg.textContent = data.error || "Error al guardar";
                        errorMsg.style.display = "block";
                    }
                } catch (err) {
                    errorMsg.textContent =
                        err instanceof Error
                            ? err.message
                            : "Error de conexión";
                    errorMsg.style.display = "block";
                } finally {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.textContent = "Agregar video";
                }
            });
        }

        document.querySelectorAll(".delete-video-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                if (!confirm("¿Eliminar este video?")) return;
                const id = btn.getAttribute("data-id");
                const res = await fetch(`/api/videos/${id}`, {
                    method: "DELETE",
                    credentials: "include",
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Error al eliminar");
                }
            });
        });
    </script>
</AdminLayout>
