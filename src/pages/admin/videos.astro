---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/index.js";
import { videos } from "../../db/schema.js";
import { desc } from "drizzle-orm";

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
    return Astro.redirect("/login");
}

const listaVideos = await db.select().from(videos).orderBy(desc(videos.id));

const getYouTubeId = (url: string): string | null => {
    if (!url) return null;
    const match = url.match(
        /(?:youtube\.com\/watch\?v=|music\.youtube\.com\/watch\?v=|youtube\.com\/shorts\/|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
    );
    return match ? match[1] : null;
};

const esVideoSubido = (url: string): boolean => {
    return url.includes(".public.blob.vercel-storage.com");
};
---

<AdminLayout title="Videos | Panel">
    <section style="padding: 3rem 0;">
        <div class="container">
            <div class="admin-page-header">
                <div>
                    <h1 class="admin-page-title">Videos</h1>
                    <p class="admin-page-subtitle">
                        Subí videos desde tu dispositivo o agregá URLs de
                        YouTube.
                    </p>
                </div>
            </div>

            <div class="admin-card" style="margin-bottom: 2.5rem;">
                <form id="video-form">
                    <div class="admin-field">
                        <label class="admin-label" for="titulo">Título *</label>
                        <input
                            id="titulo"
                            type="text"
                            name="titulo"
                            required
                            class="admin-input"
                            placeholder="Ej: Presentación en el Teatro Provincial"
                        />
                    </div>

                    <div class="admin-field">
                        <label class="admin-label">Origen del video</label>
                        <div class="imagen-tabs">
                            <button
                                type="button"
                                class="imagen-tab active"
                                data-tab="archivo">Subir archivo</button
                            >
                            <button
                                type="button"
                                class="imagen-tab"
                                data-tab="youtube">URL de YouTube</button
                            >
                        </div>

                        <div class="imagen-panel active" data-panel="archivo">
                            <input
                                type="file"
                                id="videoFile"
                                accept="video/mp4,video/webm,video/ogg"
                                class="admin-input"
                                style="padding: 0.5rem;"
                            />
                            <p
                                style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;"
                            >
                                MP4, WebM u OGG · máx 500 MB.
                            </p>
                            <div
                                id="preview-container"
                                style="display: none; margin-top: 0.8rem;"
                            >
                                <video
                                    id="preview"
                                    controls
                                    style="max-width: 100%; max-height: 200px; border-radius: 4px; border: 1px solid rgba(255, 202, 40, 0.3);"
                                ></video>
                            </div>
                        </div>

                        <div class="imagen-panel" data-panel="youtube">
                            <input
                                id="url"
                                type="url"
                                name="url"
                                class="admin-input"
                                placeholder="https://www.youtube.com/watch?v=..."
                            />
                            <p
                                style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;"
                            >
                                Pegá la URL del video de YouTube (watch, shorts,
                                youtu.be o YouTube Music).
                            </p>
                        </div>
                    </div>

                    <div class="admin-field">
                        <label class="admin-label" for="descripcion"
                            >Descripción</label
                        >
                        <textarea
                            id="descripcion"
                            name="descripcion"
                            rows="2"
                            class="admin-input"
                            placeholder="Breve descripción del video (opcional)"
                        ></textarea>
                    </div>

                    <div class="admin-actions">
                        <button type="submit" class="btn" id="submit-btn"
                            >Agregar video</button
                        >
                        <span
                            id="status-msg"
                            style="font-size: 0.85rem; color: var(--text-muted);"
                        ></span>
                    </div>
                    <p
                        id="error-msg"
                        class="admin-msg error"
                        style="display: none;"
                    >
                    </p>
                </form>
            </div>

            <!-- Buscador -->
            <div class="buscador-card">
                <div class="buscador-input-wrap">
                    <svg
                        class="buscador-icon"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input
                        type="text"
                        id="search-input"
                        class="admin-input buscador-input"
                        placeholder="Buscar por título o descripción..."
                    />
                </div>
            </div>

            <h2 style="font-size: 1.2rem; margin-bottom: 1rem;">
                Videos cargados (<span id="count-visible"
                    >{listaVideos.length}</span
                >/{listaVideos.length})
            </h2>

            {
                listaVideos.length === 0 ? (
                    <p style="color: var(--text-muted);">
                        No hay videos cargados todavía.
                    </p>
                ) : (
                    <div class="videos-grid">
                        {listaVideos.map((video) => {
                            const videoId = getYouTubeId(video.url);
                            const esSubido = esVideoSubido(video.url);
                            return (
                                <div
                                    class="video-item"
                                    data-titulo={(
                                        video.titulo || ""
                                    ).toLowerCase()}
                                    data-descripcion={(
                                        video.descripcion || ""
                                    ).toLowerCase()}
                                >
                                    <div class="video-preview">
                                        {esSubido ? (
                                            <video
                                                controls
                                                style="width: 100%; height: 100%; display: block;"
                                            >
                                                <source
                                                    src={video.url}
                                                    type="video/mp4"
                                                />
                                            </video>
                                        ) : videoId ? (
                                            <iframe
                                                src={`https://www.youtube.com/embed/${videoId}`}
                                                title={video.titulo}
                                                frameborder="0"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="video-invalid">
                                                URL inválida
                                            </div>
                                        )}
                                    </div>
                                    <div class="video-info">
                                        <h3>{video.titulo}</h3>
                                        {video.descripcion && (
                                            <p>{video.descripcion}</p>
                                        )}
                                        <div style="display: flex; gap: 0.3rem; margin-top: 0.5rem;">
                                            <button
                                                type="button"
                                                class="admin-link-btn edit-video-btn"
                                                data-id={video.id}
                                                data-titulo={video.titulo}
                                                data-descripcion={
                                                    video.descripcion || ""
                                                }
                                            >
                                                Editar
                                            </button>
                                            <button
                                                type="button"
                                                class="admin-link-btn danger delete-video-btn"
                                                data-id={video.id}
                                                data-titulo={video.titulo}
                                            >
                                                Eliminar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )
            }
        </div>
    </section>

    <!-- Modal de edición -->
    <div id="edit-modal" class="modal-overlay" style="display: none;">
        <div class="modal-box">
            <h2 class="modal-title">Editar video</h2>
            <form id="edit-form">
                <div class="admin-field">
                    <label class="admin-label" for="edit-titulo">Título *</label
                    >
                    <input
                        id="edit-titulo"
                        type="text"
                        required
                        class="admin-input"
                    />
                </div>
                <div class="admin-field">
                    <label class="admin-label" for="edit-descripcion"
                        >Descripción</label
                    >
                    <textarea id="edit-descripcion" rows="3" class="admin-input"
                    ></textarea>
                </div>
                <p
                    id="edit-error"
                    class="admin-msg error"
                    style="display: none;"
                >
                </p>
                <div class="modal-actions">
                    <button
                        type="button"
                        id="edit-cancel"
                        class="admin-link-btn"
                    >
                        Cancelar
                    </button>
                    <button type="submit" class="btn" id="edit-save">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .imagen-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.8rem;
        }
        .imagen-tab {
            background: none;
            border: 1px solid rgba(233, 30, 99, 0.3);
            color: var(--text-muted);
            padding: 0.4rem 0.9rem;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .imagen-tab:hover {
            border-color: var(--accent-soft);
            color: var(--accent-soft);
        }
        .imagen-tab.active {
            background: rgba(233, 30, 99, 0.15);
            border-color: var(--accent);
            color: var(--accent);
        }
        .imagen-panel {
            display: none;
        }
        .imagen-panel.active {
            display: block;
        }

        /* Buscador */
        .buscador-card {
            display: flex;
            gap: 0.8rem;
            margin-bottom: 1.5rem;
            align-items: center;
            flex-wrap: wrap;
        }
        .buscador-input-wrap {
            flex: 1;
            min-width: 220px;
            position: relative;
        }
        .buscador-icon {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }
        .buscador-input {
            padding-left: 2.5rem !important;
            margin: 0 !important;
        }

        /* Grid */
        .videos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }
        .video-item {
            background: var(--bg-soft);
            border: 1px solid rgba(255, 202, 40, 0.12);
            border-radius: 4px;
            overflow: hidden;
            transition:
                border-color 0.2s,
                transform 0.2s,
                box-shadow 0.2s;
        }
        .video-item:hover {
            border-color: rgba(255, 202, 40, 0.4);
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(233, 30, 99, 0.15);
        }
        .video-preview {
            position: relative;
            aspect-ratio: 16 / 9;
            background: #000;
        }
        .video-preview iframe,
        .video-preview video {
            width: 100%;
            height: 100%;
            display: block;
        }
        .video-invalid {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e74c3c;
            font-size: 0.85rem;
        }
        .video-info {
            padding: 1rem;
        }
        .video-info h3 {
            font-size: 1rem;
            margin-bottom: 0.3rem;
        }
        .video-info p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 0.8rem;
            white-space: pre-wrap;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
            padding: 1rem;
        }
        .modal-box {
            background: var(--bg);
            border: 1px solid rgba(255, 202, 40, 0.3);
            border-radius: 6px;
            padding: 2rem;
            max-width: 500px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        }
        .modal-title {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .modal-actions .admin-link-btn {
            cursor: pointer;
        }
    </style>

    <script>
        // @ts-nocheck
        import { upload } from "@vercel/blob/client";

        const form = document.getElementById("video-form");
        const errorMsg = document.getElementById("error-msg");
        const submitBtn = document.getElementById("submit-btn");
        const videoFile = document.getElementById("videoFile");
        const preview = document.getElementById("preview");
        const previewContainer = document.getElementById("preview-container");
        const urlInput = document.getElementById("url");

        // Tabs
        const tabs = document.querySelectorAll(".imagen-tab");
        const panels = document.querySelectorAll(".imagen-panel");
        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const target = tab.getAttribute("data-tab");
                tabs.forEach((t) => t.classList.remove("active"));
                tab.classList.add("active");
                panels.forEach((p) => {
                    p.classList.toggle(
                        "active",
                        p.getAttribute("data-panel") === target,
                    );
                });
            });
        });

        // Preview de video
        if (videoFile && "files" in videoFile) {
            videoFile.addEventListener("change", () => {
                const files = videoFile.files;
                if (
                    !files ||
                    typeof files !== "object" ||
                    !("length" in files)
                ) {
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "none";
                    }
                    return;
                }
                const filesArray = Array.from(files);
                const file = filesArray.length > 0 ? filesArray[0] : null;
                if (!file) {
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "none";
                    }
                    return;
                }
                const reader = new FileReader();
                reader.onload = (e) => {
                    if (preview && "src" in preview) {
                        preview.src = String(e.target ? e.target.result : "");
                    }
                    if (previewContainer && "style" in previewContainer) {
                        previewContainer.style.display = "block";
                    }
                };
                reader.readAsDataURL(file);
            });
        }

        if (form && errorMsg && submitBtn) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                submitBtn.setAttribute("disabled", "true");
                submitBtn.textContent = "Guardando...";

                const elTitulo = document.getElementById("titulo");
                const elDescripcion = document.getElementById("descripcion");
                const titulo =
                    elTitulo && "value" in elTitulo ? elTitulo.value : "";
                const descripcion =
                    elDescripcion && "value" in elDescripcion
                        ? elDescripcion.value
                        : "";

                const panelActivo = document.querySelector(
                    ".imagen-panel.active",
                );
                const archivoActivo =
                    panelActivo?.getAttribute("data-panel") === "archivo";
                let url = urlInput && "value" in urlInput ? urlInput.value : "";

                try {
                    if (
                        archivoActivo &&
                        videoFile &&
                        "files" in videoFile &&
                        videoFile.files &&
                        typeof videoFile.files === "object" &&
                        "length" in videoFile.files &&
                        videoFile.files.length > 0
                    ) {
                        const filesArray = Array.from(videoFile.files);
                        const file = filesArray[0];
                        submitBtn.textContent = "Subiendo video...";

                        const blob = await upload(file.name, file, {
                            access: "public",
                            handleUploadUrl: "/api/videos/upload-token",
                        });

                        url = blob.url;
                    }

                    if (!url) {
                        errorMsg.textContent =
                            "Seleccioná un archivo o pegá una URL de YouTube.";
                        errorMsg.style.display = "block";
                        return;
                    }

                    const res = await fetch("/api/videos", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ titulo, url, descripcion }),
                    });

                    if (res.ok) {
                        window.showToast("Video agregado", "success");
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        const data = await res.json();
                        errorMsg.textContent = data.error || "Error al guardar";
                        errorMsg.style.display = "block";
                    }
                } catch (err) {
                    errorMsg.textContent =
                        err instanceof Error
                            ? err.message
                            : "Error de conexión";
                    errorMsg.style.display = "block";
                } finally {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.textContent = "Agregar video";
                }
            });
        }

        // ==================
        // BUSCADOR
        // ==================
        const searchInput = document.getElementById("search-input");
        const countVisible = document.getElementById("count-visible");

        function aplicarFiltros() {
            const query = searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";

            let visibles = 0;
            document.querySelectorAll(".video-item").forEach((item) => {
                const titulo = item.getAttribute("data-titulo") || "";
                const descripcion = item.getAttribute("data-descripcion") || "";

                const coincide =
                    query === "" ||
                    titulo.includes(query) ||
                    descripcion.includes(query);

                item.style.display = coincide ? "" : "none";
                if (coincide) visibles++;
            });

            if (countVisible) countVisible.textContent = visibles;
        }

        if (searchInput) searchInput.addEventListener("input", aplicarFiltros);

        // ==================
        // ELIMINAR
        // ==================
        document.querySelectorAll(".delete-video-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const titulo = btn.getAttribute("data-titulo") || "este video";
                const ok = await window.confirmDialog(
                    `¿Eliminar "${titulo}"? No se podrá recuperar.`,
                    { title: "Eliminar video", okText: "Sí, eliminar" },
                );
                if (!ok) return;

                const id = btn.getAttribute("data-id");
                try {
                    const res = await fetch(`/api/videos/${id}`, {
                        method: "DELETE",
                        credentials: "include",
                    });
                    if (res.ok) {
                        window.showToast("Video eliminado", "success");
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        window.showToast("Error al eliminar", "error");
                    }
                } catch (err) {
                    window.showToast("Error de conexión", "error");
                }
            });
        });

        // ==================
        // EDITAR (modal)
        // ==================
        const editModal = document.getElementById("edit-modal");
        const editForm = document.getElementById("edit-form");
        const editTitulo = document.getElementById("edit-titulo");
        const editDescripcion = document.getElementById("edit-descripcion");
        const editError = document.getElementById("edit-error");
        const editSave = document.getElementById("edit-save");
        const editCancel = document.getElementById("edit-cancel");

        let editVideoId = null;

        document.querySelectorAll(".edit-video-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                editVideoId = btn.getAttribute("data-id");
                editTitulo.value = btn.getAttribute("data-titulo") || "";
                editDescripcion.value =
                    btn.getAttribute("data-descripcion") || "";
                editError.style.display = "none";
                editModal.style.display = "flex";
                editTitulo.focus();
            });
        });

        if (editCancel) {
            editCancel.addEventListener("click", () => {
                editModal.style.display = "none";
            });
        }

        if (editModal) {
            editModal.addEventListener("click", (e) => {
                if (e.target === editModal) {
                    editModal.style.display = "none";
                }
            });
        }

        document.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                editModal &&
                editModal.style.display !== "none"
            ) {
                editModal.style.display = "none";
            }
        });

        if (editForm) {
            editForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                editError.style.display = "none";
                editSave.setAttribute("disabled", "true");
                editSave.textContent = "Guardando...";

                const titulo = editTitulo.value.trim();
                const descripcion = editDescripcion.value.trim() || null;

                if (titulo.length < 2) {
                    editError.textContent =
                        "El título debe tener al menos 2 caracteres";
                    editError.style.display = "block";
                    editSave.removeAttribute("disabled");
                    editSave.textContent = "Guardar cambios";
                    return;
                }

                try {
                    const res = await fetch(`/api/videos/${editVideoId}`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ titulo, descripcion }),
                    });

                    if (res.ok) {
                        window.showToast("Video actualizado", "success");
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        const data = await res.json().catch(() => ({}));
                        editError.textContent =
                            data.error || "Error al actualizar";
                        editError.style.display = "block";
                        editSave.removeAttribute("disabled");
                        editSave.textContent = "Guardar cambios";
                    }
                } catch (err) {
                    editError.textContent = "Error de conexión";
                    editError.style.display = "block";
                    editSave.removeAttribute("disabled");
                    editSave.textContent = "Guardar cambios";
                }
            });
        }
    </script>
</AdminLayout>
