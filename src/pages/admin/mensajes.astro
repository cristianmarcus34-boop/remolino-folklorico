---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/index.js";
import { mensajes } from "../../db/schema.js";
import { desc } from "drizzle-orm";

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
    return Astro.redirect("/login");
}

const lista = await db.select().from(mensajes).orderBy(desc(mensajes.id));
const noLeidos = lista.filter((m) => !m.leido).length;
---

<AdminLayout title="Mensajes | Panel">
    <section style="padding: 3rem 0;">
        <div class="container">
            <div class="admin-page-header">
                <div>
                    <h1 class="admin-page-title">Mensajes</h1>
                    <p class="admin-page-subtitle">
                        Consultas recibidas desde el formulario de contacto.
                    </p>
                </div>
                <div class="mensajes-stats">
                    <span class="stat">
                        <strong>{lista.length}</strong> total
                    </span>
                    <span class="stat stat-nuevos">
                        <strong>{noLeidos}</strong> sin leer
                    </span>
                </div>
            </div>

            {
                lista.length === 0 ? (
                    <div
                        class="admin-card"
                        style="text-align: center; padding: 3rem 1.5rem;"
                    >
                        <p style="color: var(--text-muted);">
                            Todavía no hay consultas. Cuando alguien complete el
                            formulario de contrataciones, va a aparecer acá.
                        </p>
                    </div>
                ) : (
                    <div class="mensajes-list">
                        {lista.map((m) => (
                            <div
                                class:list={[
                                    "mensaje-card",
                                    { "no-leido": !m.leido },
                                ]}
                                data-id={m.id}
                            >
                                <div class="mensaje-header">
                                    <div class="mensaje-info">
                                        <div class="mensaje-titulo">
                                            <span class="mensaje-nombre">
                                                {m.nombre}
                                            </span>
                                            {!m.leido && (
                                                <span class="badge-nuevo">
                                                    Nuevo
                                                </span>
                                            )}
                                            {m.leido && (
                                                <span class="badge-leido">
                                                    Leído
                                                </span>
                                            )}
                                        </div>
                                        <div class="mensaje-meta">
                                            <span>{m.email}</span>
                                            {m.telefono && (
                                                <>
                                                    <span class="sep">·</span>
                                                    <span>{m.telefono}</span>
                                                </>
                                            )}
                                            <span class="sep">·</span>
                                            <span>
                                                {new Date(
                                                    m.createdAt,
                                                ).toLocaleDateString("es-AR", {
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric",
                                                })}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mensaje-actions">
                                        {!m.leido ? (
                                            <button
                                                type="button"
                                                class="admin-link-btn marcar-leido-btn"
                                                data-id={m.id}
                                                data-leido="true"
                                            >
                                                Marcar como leído
                                            </button>
                                        ) : (
                                            <button
                                                type="button"
                                                class="admin-link-btn marcar-no-leido-btn"
                                                data-id={m.id}
                                                data-leido="false"
                                            >
                                                Marcar como no leído
                                            </button>
                                        )}
                                        <button
                                            type="button"
                                            class="admin-link-btn danger borrar-mensaje-btn"
                                            data-id={m.id}
                                            data-nombre={m.nombre}
                                        >
                                            Eliminar
                                        </button>
                                    </div>
                                </div>

                                <div class="mensaje-detalles">
                                    {m.tipoEvento && (
                                        <div class="detalle">
                                            <span class="detalle-label">
                                                Tipo de evento
                                            </span>
                                            <span>{m.tipoEvento}</span>
                                        </div>
                                    )}
                                    {m.fechaEvento && (
                                        <div class="detalle">
                                            <span class="detalle-label">
                                                Fecha estimada
                                            </span>
                                            <span>{m.fechaEvento}</span>
                                        </div>
                                    )}
                                </div>

                                <div class="mensaje-cuerpo">
                                    <p>{m.mensaje}</p>
                                </div>

                                <div class="mensaje-footer">
                                    <a
                                        href={`mailto:${m.email}?subject=Re: consulta desde Remolino Folklórico`}
                                        class="admin-link-btn"
                                    >
                                        Responder por email
                                    </a>
                                    {m.telefono && (
                                        <a
                                            href={`https://wa.me/549${m.telefono.replace(/\D/g, "")}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="admin-link-btn"
                                        >
                                            Responder por WhatsApp
                                        </a>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <script>
        // @ts-nocheck
        // ==================
        // MARCAR COMO LEÍDO / NO LEÍDO (toggle)
        // ==================
        async function toggleLeido(id, nuevoEstado) {
            try {
                const res = await fetch(`/api/mensajes/${id}`, {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ leido: nuevoEstado }),
                });
                if (res.ok) {
                    const mensaje = nuevoEstado
                        ? "Mensaje marcado como leído"
                        : "Mensaje marcado como no leído";
                    window.showToast(mensaje, "success");
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    const data = await res.json().catch(() => ({}));
                    window.showToast(
                        data.error || "Error al actualizar el mensaje",
                        "error",
                    );
                }
            } catch (err) {
                window.showToast("Error de conexión", "error");
            }
        }

        document.querySelectorAll(".marcar-leido-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const id = btn.getAttribute("data-id");
                btn.setAttribute("disabled", "true");
                await toggleLeido(id, true);
            });
        });

        document.querySelectorAll(".marcar-no-leido-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const id = btn.getAttribute("data-id");
                btn.setAttribute("disabled", "true");
                await toggleLeido(id, false);
            });
        });

        // ==================
        // ELIMINAR MENSAJE
        // ==================
        document.querySelectorAll(".borrar-mensaje-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const nombre =
                    btn.getAttribute("data-nombre") || "este mensaje";
                const ok = await window.confirmDialog(
                    `¿Eliminar el mensaje de ${nombre}? Esta acción no se puede deshacer.`,
                    { title: "Eliminar mensaje", okText: "Sí, eliminar" },
                );
                if (!ok) return;

                const id = btn.getAttribute("data-id");
                btn.setAttribute("disabled", "true");
                try {
                    const res = await fetch(`/api/mensajes/${id}`, {
                        method: "DELETE",
                        credentials: "include",
                    });
                    if (res.ok) {
                        window.showToast("Mensaje eliminado", "success");
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        const data = await res.json().catch(() => ({}));
                        window.showToast(
                            data.error || "Error al eliminar",
                            "error",
                        );
                        btn.removeAttribute("disabled");
                    }
                } catch (err) {
                    window.showToast("Error de conexión", "error");
                    btn.removeAttribute("disabled");
                }
            });
        });
    </script>

    <style>
        .admin-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }
        .mensajes-stats {
            display: flex;
            gap: 1.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .stat strong {
            color: var(--text);
            font-size: 1.1rem;
            font-family: var(--font-serif);
        }
        .stat-nuevos strong {
            color: var(--accent-soft);
        }
        .mensajes-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .mensaje-card {
            background: var(--bg-soft);
            border: 1px solid rgba(212, 168, 83, 0.12);
            border-radius: 4px;
            padding: 1.5rem;
            transition: border-color 0.2s;
        }
        .mensaje-card:hover {
            border-color: rgba(212, 168, 83, 0.3);
        }
        .mensaje-card.no-leido {
            border-left: 3px solid var(--accent);
        }
        .mensaje-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        .mensaje-info {
            flex: 1;
            min-width: 0;
        }
        .mensaje-titulo {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            margin-bottom: 0.3rem;
            flex-wrap: wrap;
        }
        .mensaje-nombre {
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--text);
        }
        .badge-nuevo {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.15rem 0.5rem;
            border-radius: 2px;
            background: var(--accent);
            color: var(--text);
        }
        .badge-leido {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.15rem 0.5rem;
            border-radius: 2px;
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-muted);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        .mensaje-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .mensaje-meta .sep {
            opacity: 0.5;
        }
        .mensaje-actions {
            display: flex;
            gap: 0.3rem;
            flex-shrink: 0;
        }
        .mensaje-actions .admin-link-btn:disabled {
            opacity: 0.5;
            cursor: wait;
        }
        .mensaje-detalles {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            padding: 0.8rem 0;
            border-top: 1px solid rgba(212, 168, 83, 0.08);
            border-bottom: 1px solid rgba(212, 168, 83, 0.08);
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }
        .detalle {
            display: flex;
            gap: 0.4rem;
        }
        .detalle-label {
            color: var(--text-muted);
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 0.08em;
        }
        .mensaje-cuerpo {
            color: var(--text-muted);
            font-weight: 300;
            line-height: 1.7;
            white-space: pre-wrap;
            font-size: 0.95rem;
            margin-bottom: 1rem;
        }
        .mensaje-footer {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        @media (max-width: 640px) {
            .mensaje-header {
                flex-direction: column;
            }
            .mensaje-actions {
                width: 100%;
                justify-content: flex-end;
            }
            .mensaje-detalles {
                flex-direction: column;
                gap: 0.5rem;
            }
        }
    </style>
</AdminLayout>
