---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { db } from "../../db/index.js";
import { galeria } from "../../db/schema.js";
import { asc } from "drizzle-orm";

export const prerender = false;

const session = Astro.locals.session;
if (!session) {
    return Astro.redirect("/login");
}

const imagenes = await db.select().from(galeria).orderBy(asc(galeria.orden));
---

<AdminLayout title="Galería | Panel">
    <section style="padding: 3rem 0;">
        <div class="container">
            <h1 class="admin-page-title">Galería</h1>
            <p class="admin-page-subtitle">
                Subí y gestioná las fotos del grupo.
            </p>

            <!-- Formulario de subida -->
            <div class="admin-card" style="margin-bottom: 2.5rem;">
                <form id="upload-form">
                    <div id="dropzone" class="dropzone">
                        <input
                            type="file"
                            name="file"
                            accept="image/*"
                            required
                            id="file-input"
                            hidden
                        />
                        <div id="dropzone-content">
                            <svg
                                width="32"
                                height="32"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                style="color: var(--accent-soft); margin-bottom: 0.8rem;"
                            >
                                <path
                                    d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"
                                ></path>
                            </svg>
                            <p style="margin-bottom: 0.3rem;">
                                Arrastrá una imagen o hacé clic para seleccionar
                            </p>
                            <p
                                style="font-size: 0.8rem; color: var(--text-muted);"
                            >
                                JPG, PNG o WebP · máx 10 MB
                            </p>
                        </div>
                        <img
                            id="preview"
                            style="display: none; max-width: 100%; max-height: 300px; border-radius: 2px;"
                        />
                    </div>

                    <div class="admin-field" style="margin-top: 1.2rem;">
                        <label class="admin-label" for="alt"
                            >Descripción (alt) *</label
                        >
                        <input
                            id="alt"
                            type="text"
                            name="alt"
                            required
                            class="admin-input"
                            placeholder="Ej: Presentación en el Teatro Provincial"
                        />
                    </div>

                    <div class="admin-field">
                        <label class="admin-label" for="seccion"
                            >¿Dónde se muestra?</label
                        >
                        <select id="seccion" name="seccion" class="admin-input">
                            <option value=""
                                >Solo en la galería (sin destacar)</option
                            >
                            <option value="galeria_destacada"
                                >Destacada en Galería (grande)</option
                            >
                            <option value="nosotros"
                                >Foto principal en Nosotros</option
                            >
                            <option value="inicio">Imagen en el Inicio</option>
                            <option value="eventos">Imagen en Eventos</option>
                            <option value="sumate"
                                >Imagen en "Sumate al grupo"</option
                            >
                        </select>
                    </div>

                    <div class="admin-actions">
                        <button type="submit" class="btn" id="submit-btn"
                            >Subir imagen</button
                        >
                        <span
                            id="status-msg"
                            style="font-size: 0.85rem; color: var(--text-muted);"
                        ></span>
                    </div>
                    <p
                        id="error-msg"
                        class="admin-msg error"
                        style="display: none;"
                    >
                    </p>
                </form>
            </div>

            <!-- Buscador y filtros -->
            <div class="buscador-card">
                <div class="buscador-input-wrap">
                    <svg
                        class="buscador-icon"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input
                        type="text"
                        id="search-input"
                        class="admin-input buscador-input"
                        placeholder="Buscar por descripción..."
                    />
                </div>
                <select id="filter-seccion" class="admin-input buscador-select">
                    <option value="">Todas las secciones</option>
                    <option value="__sin_asignar">Solo galería</option>
                    <option value="galeria_destacada"
                        >Destacada en Galería</option
                    >
                    <option value="nosotros">Nosotros</option>
                    <option value="inicio">Inicio</option>
                    <option value="eventos">Eventos</option>
                    <option value="sumate">Sumate al grupo</option>
                </select>
            </div>

            <h2 style="font-size: 1.2rem; margin-bottom: 1rem;">
                Imágenes cargadas (<span id="count-visible"
                    >{imagenes.length}</span
                >/{imagenes.length})
            </h2>

            {
                imagenes.length === 0 ? (
                    <p style="color: var(--text-muted);">
                        No hay imágenes en la galería todavía.
                    </p>
                ) : (
                    <div class="galeria-grid" id="galeria-grid">
                        {imagenes.map((img) => (
                            <div
                                class="galeria-item"
                                draggable="true"
                                data-id={img.id}
                                data-alt={(img.alt || "").toLowerCase()}
                                data-seccion={img.seccion || "__sin_asignar"}
                            >
                                <div
                                    class="drag-handle"
                                    title="Arrastrá para reordenar"
                                >
                                    <svg
                                        width="14"
                                        height="14"
                                        viewBox="0 0 24 24"
                                        fill="currentColor"
                                    >
                                        <circle cx="9" cy="6" r="1.5" />
                                        <circle cx="9" cy="12" r="1.5" />
                                        <circle cx="9" cy="18" r="1.5" />
                                        <circle cx="15" cy="6" r="1.5" />
                                        <circle cx="15" cy="12" r="1.5" />
                                        <circle cx="15" cy="18" r="1.5" />
                                    </svg>
                                </div>
                                <img
                                    src={img.url}
                                    alt={img.alt}
                                    loading="lazy"
                                />
                                <div class="galeria-info">
                                    <div style="flex: 1; min-width: 0;">
                                        <p
                                            title={img.alt}
                                            style="margin: 0 0 0.4rem 0;"
                                        >
                                            {img.alt}
                                        </p>
                                        <select
                                            class="seccion-select"
                                            data-id={img.id}
                                            style="width: 100%; padding: 0.35rem 0.5rem; background: var(--bg); border: 1px solid rgba(255,202,40,0.2); color: var(--text); border-radius: 2px; font-size: 0.75rem;"
                                        >
                                            <option
                                                value=""
                                                selected={!img.seccion}
                                            >
                                                Solo galería
                                            </option>
                                            <option
                                                value="galeria_destacada"
                                                selected={
                                                    img.seccion ===
                                                    "galeria_destacada"
                                                }
                                            >
                                                Destacada en Galería
                                            </option>
                                            <option
                                                value="nosotros"
                                                selected={
                                                    img.seccion === "nosotros"
                                                }
                                            >
                                                Nosotros
                                            </option>
                                            <option
                                                value="inicio"
                                                selected={
                                                    img.seccion === "inicio"
                                                }
                                            >
                                                Inicio
                                            </option>
                                            <option
                                                value="eventos"
                                                selected={
                                                    img.seccion === "eventos"
                                                }
                                            >
                                                Eventos
                                            </option>
                                            <option
                                                value="sumate"
                                                selected={
                                                    img.seccion === "sumate"
                                                }
                                            >
                                                Sumate al grupo
                                            </option>
                                        </select>
                                    </div>
                                    <div style="display: flex; gap: 0.3rem; flex-shrink: 0;">
                                        <button
                                            type="button"
                                            class="admin-link-btn edit-img-btn"
                                            data-id={img.id}
                                            data-alt={img.alt}
                                            data-seccion={img.seccion || ""}
                                            data-url={img.url}
                                        >
                                            Editar
                                        </button>
                                        <button
                                            type="button"
                                            class="admin-link-btn danger delete-img-btn"
                                            data-id={img.id}
                                            data-alt={img.alt}
                                        >
                                            Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <!-- Modal de edición -->
    <div id="edit-modal" class="modal-overlay" style="display: none;">
        <div class="modal-box">
            <h2 class="modal-title">Editar imagen</h2>
            <form id="edit-form">
                <!-- Preview de la imagen actual -->
                <div class="edit-imagen-actual">
                    <img
                        id="edit-imagen-preview"
                        src=""
                        alt="Imagen actual"
                        loading="lazy"
                    />
                </div>

                <!-- Input para cambiar la imagen -->
                <div class="admin-field">
                    <label class="admin-label" for="edit-imagen-file"
                        >Cambiar imagen (opcional)</label
                    >
                    <input
                        type="file"
                        id="edit-imagen-file"
                        accept="image/*"
                        class="admin-input"
                        style="padding: 0.5rem;"
                    />
                    <p class="edit-help">
                        Si no elegís una nueva, se mantiene la actual.
                    </p>
                    <p
                        class="edit-warning"
                        id="edit-warning"
                        style="display: none;"
                    >
                        ⚠️ Al guardar, la imagen actual se eliminará de Vercel
                        Blob y no se podrá recuperar.
                    </p>
                </div>

                <div class="admin-field">
                    <label class="admin-label" for="edit-alt"
                        >Descripción (alt) *</label
                    >
                    <input
                        id="edit-alt"
                        type="text"
                        required
                        minlength="2"
                        class="admin-input"
                    />
                </div>

                <div class="admin-field">
                    <label class="admin-label" for="edit-seccion"
                        >¿Dónde se muestra?</label
                    >
                    <select id="edit-seccion" class="admin-input">
                        <option value=""
                            >Solo en la galería (sin destacar)</option
                        >
                        <option value="galeria_destacada"
                            >Destacada en Galería (grande)</option
                        >
                        <option value="nosotros"
                            >Foto principal en Nosotros</option
                        >
                        <option value="inicio">Imagen en el Inicio</option>
                        <option value="eventos">Imagen en Eventos</option>
                        <option value="sumate"
                            >Imagen en "Sumate al grupo"</option
                        >
                    </select>
                </div>

                <p
                    id="edit-error"
                    class="admin-msg error"
                    style="display: none;"
                >
                </p>

                <div class="modal-actions">
                    <button
                        type="button"
                        id="edit-cancel"
                        class="admin-link-btn"
                    >
                        Cancelar
                    </button>
                    <button type="submit" class="btn" id="edit-save">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .dropzone {
            border: 2px dashed rgba(233, 30, 99, 0.3);
            border-radius: 4px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition:
                border-color 0.2s,
                background 0.2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 180px;
        }
        .dropzone:hover,
        .dropzone.dragover {
            border-color: var(--accent-soft);
            background: rgba(233, 30, 99, 0.05);
        }

        /* Buscador */
        .buscador-card {
            display: flex;
            gap: 0.8rem;
            margin-bottom: 1.5rem;
            align-items: center;
            flex-wrap: wrap;
        }
        .buscador-input-wrap {
            flex: 1;
            min-width: 220px;
            position: relative;
        }
        .buscador-icon {
            position: absolute;
            left: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }
        .buscador-input {
            padding-left: 2.5rem !important;
            margin: 0 !important;
        }
        .buscador-select {
            min-width: 200px;
            margin: 0 !important;
        }

        /* Grid */
        .galeria-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1rem;
        }
        .galeria-item {
            position: relative;
            background: var(--bg-soft);
            border: 1px solid rgba(255, 202, 40, 0.12);
            border-radius: 4px;
            overflow: hidden;
            transition:
                border-color 0.2s,
                transform 0.2s,
                box-shadow 0.2s,
                opacity 0.2s;
            cursor: grab;
        }
        .galeria-item:hover {
            border-color: rgba(255, 202, 40, 0.4);
            transform: translateY(-2px);
        }
        .galeria-item.dragging {
            opacity: 0.4;
            cursor: grabbing;
        }
        .galeria-item.drag-over {
            border-color: var(--accent-soft);
            box-shadow: 0 0 20px rgba(233, 30, 99, 0.5);
            transform: scale(1.02);
        }
        .drag-handle {
            position: absolute;
            top: 0.5rem;
            left: 0.5rem;
            background: rgba(0, 0, 0, 0.7);
            color: rgba(255, 255, 255, 0.8);
            border-radius: 3px;
            padding: 0.25rem;
            cursor: grab;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }
        .galeria-item:hover .drag-handle {
            background: rgba(233, 30, 99, 0.8);
            color: #fff;
        }
        .galeria-item img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            display: block;
            pointer-events: none;
        }
        .galeria-info {
            padding: 0.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            background: var(--bg-soft);
            position: relative;
            z-index: 1;
        }
        .galeria-info p {
            color: var(--text-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 999;
            padding: 1rem;
        }
        .modal-box {
            background: var(--bg);
            border: 1px solid rgba(255, 202, 40, 0.3);
            border-radius: 6px;
            padding: 2rem;
            max-width: 550px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        }
        .modal-title {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
            color: #ffffff;
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 1.5rem;
        }
        .modal-actions .admin-link-btn {
            cursor: pointer;
        }

        /* Preview imagen en modal */
        .edit-imagen-actual {
            display: flex;
            justify-content: center;
            margin-bottom: 1.2rem;
            padding: 0.5rem;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 202, 40, 0.15);
            border-radius: 4px;
        }
        .edit-imagen-actual img {
            max-width: 100%;
            max-height: 200px;
            border-radius: 4px;
            object-fit: contain;
        }
        .edit-help {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.4rem;
        }
        .edit-warning {
            font-size: 0.8rem;
            color: #ff9800;
            margin-top: 0.5rem;
            padding: 0.5rem 0.7rem;
            background: rgba(255, 152, 0, 0.08);
            border: 1px solid rgba(255, 152, 0, 0.3);
            border-radius: 4px;
        }
    </style>

    <script>
        // @ts-nocheck
        import { upload } from "@vercel/blob/client";

        const form = document.getElementById("upload-form");
        const fileInput = document.getElementById("file-input");
        const dropzone = document.getElementById("dropzone");
        const dropzoneContent = document.getElementById("dropzone-content");
        const preview = document.getElementById("preview");
        const submitBtn = document.getElementById("submit-btn");
        const statusMsg = document.getElementById("status-msg");
        const errorMsg = document.getElementById("error-msg");

        // ==================
        // SUBIR IMAGEN
        // ==================
        if (dropzone && fileInput) {
            dropzone.addEventListener("click", () => fileInput.click());

            dropzone.addEventListener("dragover", (e) => {
                e.preventDefault();
                dropzone.classList.add("dragover");
            });

            dropzone.addEventListener("dragleave", () => {
                dropzone.classList.remove("dragover");
            });

            dropzone.addEventListener("drop", (e) => {
                e.preventDefault();
                dropzone.classList.remove("dragover");
                if (e.dataTransfer && e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    showPreview();
                }
            });

            fileInput.addEventListener("change", showPreview);
        }

        function showPreview() {
            if (!fileInput || !fileInput.files) return;
            const filesArray = Array.from(fileInput.files);
            const file = filesArray.length > 0 ? filesArray[0] : null;
            if (!file || !preview || !dropzoneContent) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                preview.src = String(e.target ? e.target.result : "");
                preview.style.display = "block";
                dropzoneContent.style.display = "none";
            };
            reader.readAsDataURL(file);
        }

        if (form && submitBtn && statusMsg && errorMsg && fileInput) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                statusMsg.textContent = "Subiendo...";
                submitBtn.setAttribute("disabled", "true");

                let file = null;
                if (fileInput.files && fileInput.files.length > 0) {
                    const filesArray = Array.from(fileInput.files);
                    file = filesArray[0];
                }

                const altInput = document.getElementById("alt");
                const seccionSelect = document.getElementById("seccion");
                const alt =
                    altInput && "value" in altInput ? altInput.value : "";
                const seccion =
                    seccionSelect && "value" in seccionSelect
                        ? seccionSelect.value
                        : null;

                if (!file) {
                    errorMsg.textContent = "Seleccioná una imagen";
                    errorMsg.style.display = "block";
                    submitBtn.removeAttribute("disabled");
                    return;
                }

                try {
                    const blob = await upload(file.name, file, {
                        access: "public",
                        handleUploadUrl: "/api/upload-token",
                    });

                    const url = blob.url;

                    const saveRes = await fetch("/api/galeria", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ alt, url, seccion }),
                    });

                    if (!saveRes.ok) {
                        const data = await saveRes.json();
                        throw new Error(
                            data.error || "Error al guardar en la base",
                        );
                    }

                    window.showToast("Imagen subida correctamente", "success");
                    setTimeout(() => window.location.reload(), 800);
                } catch (err) {
                    errorMsg.textContent =
                        err instanceof Error
                            ? err.message
                            : "Error de conexión";
                    errorMsg.style.display = "block";
                    statusMsg.textContent = "";
                } finally {
                    submitBtn.removeAttribute("disabled");
                }
            });
        }

        // ==================
        // BUSCADOR Y FILTRO
        // ==================
        const searchInput = document.getElementById("search-input");
        const filterSeccion = document.getElementById("filter-seccion");
        const countVisible = document.getElementById("count-visible");

        function aplicarFiltros() {
            const query = searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";
            const seccionFiltro = filterSeccion ? filterSeccion.value : "";

            let visibles = 0;
            document.querySelectorAll(".galeria-item").forEach((item) => {
                const alt = item.getAttribute("data-alt") || "";
                const seccion =
                    item.getAttribute("data-seccion") || "__sin_asignar";

                const coincideTexto = query === "" || alt.includes(query);
                const coincideSeccion =
                    seccionFiltro === "" || seccion === seccionFiltro;

                const visible = coincideTexto && coincideSeccion;
                item.style.display = visible ? "" : "none";
                if (visible) visibles++;
            });

            if (countVisible) countVisible.textContent = visibles;
        }

        if (searchInput) searchInput.addEventListener("input", aplicarFiltros);
        if (filterSeccion)
            filterSeccion.addEventListener("change", aplicarFiltros);

        // ==================
        // CAMBIO RÁPIDO DE SECCIÓN
        // ==================
        document.querySelectorAll(".seccion-select").forEach((sel) => {
            sel.addEventListener("change", async () => {
                if (!("value" in sel)) return;
                const id = sel.getAttribute("data-id");
                const seccion = sel.value || null;

                const item = sel.closest(".galeria-item");
                if (item) {
                    item.setAttribute(
                        "data-seccion",
                        seccion || "__sin_asignar",
                    );
                }

                try {
                    const res = await fetch(`/api/galeria/${id}`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ seccion }),
                    });
                    if (res.ok) {
                        window.showToast("Sección actualizada", "success");
                        aplicarFiltros();
                    } else {
                        window.showToast(
                            "Error al actualizar la sección",
                            "error",
                        );
                        setTimeout(() => window.location.reload(), 800);
                    }
                } catch (err) {
                    window.showToast("Error de conexión", "error");
                    setTimeout(() => window.location.reload(), 800);
                }
            });
        });

        // ==================
        // ELIMINAR
        // ==================
        document.querySelectorAll(".delete-img-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
                const altText = btn.getAttribute("data-alt") || "esta imagen";
                const ok = await window.confirmDialog(
                    `¿Eliminar "${altText}"? No se podrá recuperar.`,
                    { title: "Eliminar imagen", okText: "Sí, eliminar" },
                );
                if (!ok) return;

                const id = btn.getAttribute("data-id");
                try {
                    const res = await fetch(`/api/galeria/${id}`, {
                        method: "DELETE",
                        credentials: "include",
                    });
                    if (res.ok) {
                        window.showToast("Imagen eliminada", "success");
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        window.showToast("Error al eliminar", "error");
                    }
                } catch (err) {
                    window.showToast("Error de conexión", "error");
                }
            });
        });

        // ==================
        // EDITAR (modal con cambio de imagen)
        // ==================
        const editModal = document.getElementById("edit-modal");
        const editForm = document.getElementById("edit-form");
        const editAlt = document.getElementById("edit-alt");
        const editSeccion = document.getElementById("edit-seccion");
        const editImagenFile = document.getElementById("edit-imagen-file");
        const editImagenPreview = document.getElementById(
            "edit-imagen-preview",
        );
        const editWarning = document.getElementById("edit-warning");
        const editError = document.getElementById("edit-error");
        const editSave = document.getElementById("edit-save");
        const editCancel = document.getElementById("edit-cancel");

        let editImgId = null;
        let editImgUrlActual = null;

        document.querySelectorAll(".edit-img-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                editImgId = btn.getAttribute("data-id");
                editImgUrlActual = btn.getAttribute("data-url") || "";
                editAlt.value = btn.getAttribute("data-alt") || "";
                editSeccion.value = btn.getAttribute("data-seccion") || "";
                editImagenPreview.src = editImgUrlActual;
                editImagenFile.value = ""; // resetear input de archivo
                editWarning.style.display = "none";
                editError.style.display = "none";
                editSave.removeAttribute("disabled");
                editSave.textContent = "Guardar cambios";
                editModal.style.display = "flex";
                editAlt.focus();
            });
        });

        // Preview de nueva imagen + mostrar advertencia
        if (editImagenFile) {
            editImagenFile.addEventListener("change", () => {
                const files = editImagenFile.files;
                if (!files || files.length === 0) {
                    editWarning.style.display = "none";
                    editImagenPreview.src = editImgUrlActual;
                    return;
                }
                const file = files[0];
                const reader = new FileReader();
                reader.onload = (e) => {
                    editImagenPreview.src = String(
                        e.target ? e.target.result : "",
                    );
                    editWarning.style.display = "block";
                };
                reader.readAsDataURL(file);
            });
        }

        if (editCancel) {
            editCancel.addEventListener("click", () => {
                editModal.style.display = "none";
            });
        }

        if (editModal) {
            editModal.addEventListener("click", (e) => {
                if (e.target === editModal) {
                    editModal.style.display = "none";
                }
            });
        }

        document.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                editModal &&
                editModal.style.display !== "none"
            ) {
                editModal.style.display = "none";
            }
        });

        if (editForm) {
            editForm.addEventListener("submit", async (e) => {
                e.preventDefault();
                editError.style.display = "none";
                editSave.setAttribute("disabled", "true");
                editSave.textContent = "Guardando...";

                const alt = editAlt.value.trim();
                const seccion = editSeccion.value || null;

                if (alt.length < 2) {
                    editError.textContent =
                        "La descripción debe tener al menos 2 caracteres";
                    editError.style.display = "block";
                    editSave.removeAttribute("disabled");
                    editSave.textContent = "Guardar cambios";
                    return;
                }

                try {
                    // 1. Si hay archivo nuevo, subirlo primero
                    let urlNueva = null;
                    const files = editImagenFile.files;
                    if (files && files.length > 0) {
                        const file = files[0];
                        editSave.textContent = "Subiendo imagen...";
                        const blob = await upload(file.name, file, {
                            access: "public",
                            handleUploadUrl: "/api/upload-token",
                        });
                        urlNueva = blob.url;
                        editSave.textContent = "Guardando...";
                    }

                    // 2. Armar el body del PATCH
                    const body = { alt, seccion };
                    if (urlNueva) {
                        body.url = urlNueva;
                    }

                    // 3. Enviar el PATCH
                    const res = await fetch(`/api/galeria/${editImgId}`, {
                        method: "PATCH",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify(body),
                    });

                    if (res.ok) {
                        window.showToast(
                            urlNueva
                                ? "Imagen actualizada (reemplazada)"
                                : "Imagen actualizada",
                            "success",
                        );
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        const data = await res.json().catch(() => ({}));
                        editError.textContent =
                            data.error || "Error al actualizar";
                        editError.style.display = "block";
                        editSave.removeAttribute("disabled");
                        editSave.textContent = "Guardar cambios";
                    }
                } catch (err) {
                    editError.textContent =
                        err instanceof Error
                            ? err.message
                            : "Error de conexión";
                    editError.style.display = "block";
                    editSave.removeAttribute("disabled");
                    editSave.textContent = "Guardar cambios";
                }
            });
        }

        // ==================
        // DRAG & DROP
        // ==================
        const grid = document.getElementById("galeria-grid");
        let draggedEl = null;
        let ordenGuardadoTimer = null;

        if (grid) {
            grid.querySelectorAll(".galeria-item").forEach((item) => {
                item.addEventListener("dragstart", (e) => {
                    draggedEl = item;
                    item.classList.add("dragging");
                    e.dataTransfer.effectAllowed = "move";
                    try {
                        e.dataTransfer.setData("text/plain", item.dataset.id);
                    } catch (err) {}
                });

                item.addEventListener("dragend", () => {
                    item.classList.remove("dragging");
                    grid.querySelectorAll(".galeria-item").forEach((i) =>
                        i.classList.remove("drag-over"),
                    );
                    draggedEl = null;
                });

                item.addEventListener("dragover", (e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = "move";
                    if (item === draggedEl) return;
                    item.classList.add("drag-over");
                });

                item.addEventListener("dragleave", () => {
                    item.classList.remove("drag-over");
                });

                item.addEventListener("drop", (e) => {
                    e.preventDefault();
                    item.classList.remove("drag-over");
                    if (!draggedEl || draggedEl === item) return;

                    const items = [...grid.querySelectorAll(".galeria-item")];
                    const draggedIdx = items.indexOf(draggedEl);
                    const targetIdx = items.indexOf(item);

                    if (draggedIdx < targetIdx) {
                        item.parentNode.insertBefore(
                            draggedEl,
                            item.nextSibling,
                        );
                    } else {
                        item.parentNode.insertBefore(draggedEl, item);
                    }

                    if (ordenGuardadoTimer) clearTimeout(ordenGuardadoTimer);
                    ordenGuardadoTimer = setTimeout(guardarOrden, 300);
                });
            });
        }

        async function guardarOrden() {
            if (!grid) return;
            const nuevoOrden = [...grid.querySelectorAll(".galeria-item")].map(
                (el) => Number(el.getAttribute("data-id")),
            );

            try {
                const res = await fetch("/api/galeria/reorder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ orden: nuevoOrden }),
                });
                if (res.ok) {
                    window.showToast("Orden guardado", "success");
                } else {
                    window.showToast("Error al guardar el orden", "error");
                }
            } catch (err) {
                window.showToast("Error de conexión", "error");
            }
        }
    </script>
</AdminLayout>
