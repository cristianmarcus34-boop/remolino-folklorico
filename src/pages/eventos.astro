---
// src/pages/eventos.astro
import '../styles/global.css';
import Layout from '../layouts/layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const eventos = [
  {
    fecha: '2026-11-15',
    titulo: 'Peña de fin de año',
    lugar: 'Centro Cultural Municipal',
    hora: '21:00 hs',
  },
  {
    fecha: '2026-12-05',
    titulo: 'Festival de danzas',
    lugar: 'Teatro Provincial',
    hora: '19:30 hs',
  },
  {
    fecha: '2026-12-20',
    titulo: 'Presentación navideña',
    lugar: 'Plaza Central',
    hora: '18:00 hs',
  },
];

const formatearFecha = (iso) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('es-AR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<layout title="Eventos | Remolino Folklórico">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Agenda</p>
      <h1>Próximos eventos</h1>
    </div>
  </section>

  <section>
    <div class="container reveal">
      {eventos.length === 0 ? (
        <p class="empty">No hay eventos programados por el momento.</p>
      ) : (
        <ul class="events-list">
          {eventos.map((evento) => (
            <li class="event">
              <div class="event-date">
                <span class="day">{new Date(evento.fecha + 'T00:00:00').getDate()}</span>
                <span class="month">
                  {new Date(evento.fecha + 'T00:00:00').toLocaleDateString('es-AR', { month: 'short' })}
                </span>
              </div>
              <div class="event-info">
                <h3>{evento.titulo}</h3>
                <p>{evento.lugar} · {evento.hora}</p>
                <p class="fecha-completa">{formatearFecha(evento.fecha)}</p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <ScrollReveal />

  <style>
    .page-hero {
      padding: 6rem 0 3rem;
      background: radial-gradient(ellipse at top, rgba(199, 91, 57, 0.12), transparent 60%);
    }
    .kicker {
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 0.8rem;
      color: var(--accent-soft);
      margin-bottom: 1rem;
    }
    .empty {
      color: var(--text-muted);
      font-style: italic;
    }
    .events-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .event {
      display: flex;
      gap: 2rem;
      align-items: center;
      background: var(--bg-soft);
      padding: 1.5rem 2rem;
      border-left: 3px solid var(--accent);
    }
    .event-date {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 70px;
    }
    .day {
      font-family: var(--font-serif);
      font-size: 2.5rem;
      line-height: 1;
      color: var(--accent-soft);
    }
    .month {
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      color: var(--text-muted);
    }
    .event-info h3 {
      margin-bottom: 0.3rem;
    }
    .event-info p {
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 300;
    }
    .fecha-completa {
      font-size: 0.85rem !important;
      opacity: 0.7;
      margin-top: 0.3rem;
    }
    @media (max-width: 640px) {
      .event { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .event-date { flex-direction: row; gap: 0.5rem; align-items: baseline; }
      .page-hero { padding: 4rem 0 2rem; }
    }
  </style>
</layout>