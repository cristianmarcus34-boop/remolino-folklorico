---
// src/pages/eventos.astro
import "../styles/global.css";
import Layout from "../layouts/layout.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { db } from "../db/index.js";
import { eventos } from "../db/schema.js";
import { asc } from "drizzle-orm";

export const prerender = false;

const listaEventos = await db
  .select()
  .from(eventos)
  .orderBy(asc(eventos.fecha));

const formatearFecha = (fecha: Date) =>
  new Date(fecha).toLocaleDateString("es-AR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Layout title="Eventos | Remolino Folklórico">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Agenda</p>
      <h1>Próximos eventos</h1>
    </div>
  </section>

  <section>
    <div class="container reveal">
      {
        listaEventos.length === 0 ? (
          <p style="color: var(--text-muted); font-style: italic;">
            No hay eventos programados por el momento.
          </p>
        ) : (
          <ul class="events-list">
            {listaEventos.map((evento) => (
              <li class="event">
                <div class="event-image">
                  {evento.imagenUrl ? (
                    <img
                      src={evento.imagenUrl}
                      alt={evento.titulo}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="event-image-placeholder">
                      <svg
                        width="32"
                        height="32"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                      >
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="event-date">
                  <span class="day">{new Date(evento.fecha).getDate()}</span>
                  <span class="month">
                    {new Date(evento.fecha).toLocaleDateString("es-AR", {
                      month: "short",
                    })}
                  </span>
                </div>
                <div class="event-info">
                  <h3>{evento.titulo}</h3>
                  <p>
                    {evento.lugar}
                    {evento.hora ? ` · ${evento.hora}` : ""}
                  </p>
                  <p class="fecha-completa">{formatearFecha(evento.fecha)}</p>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <ScrollReveal />

  <style>
    .page-hero {
      padding: 6rem 0 3rem;
      background: radial-gradient(
        ellipse at top,
        rgba(199, 91, 57, 0.12),
        transparent 60%
      );
    }
    .kicker {
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 0.8rem;
      color: var(--accent-soft);
      margin-bottom: 1rem;
    }
    .events-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .event {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      background: var(--bg-soft);
      padding: 1.2rem 1.5rem;
      border-left: 3px solid var(--accent);
      overflow: hidden;
    }
    .event-image {
      width: 120px;
      height: 120px;
      flex-shrink: 0;
      border-radius: 3px;
      overflow: hidden;
      background: rgba(212, 168, 83, 0.06);
    }
    .event-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .event:hover .event-image img {
      transform: scale(1.06);
    }
    .event-image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      opacity: 0.5;
    }
    .event-date {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 60px;
    }
    .day {
      font-family: var(--font-serif);
      font-size: 2.2rem;
      line-height: 1;
      color: var(--accent-soft);
    }
    .month {
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--text-muted);
    }
    .event-info {
      flex: 1;
      min-width: 0;
    }
    .event-info h3 {
      margin-bottom: 0.3rem;
    }
    .event-info p {
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 300;
    }
    .fecha-completa {
      font-size: 0.85rem !important;
      opacity: 0.7;
      margin-top: 0.3rem;
    }
    @media (max-width: 640px) {
      .event {
        flex-wrap: wrap;
        padding: 1.2rem;
        gap: 1rem;
      }
      .event-image {
        width: 100%;
        height: 180px;
      }
      .event-date {
        flex-direction: row;
        gap: 0.5rem;
        align-items: baseline;
      }
      .day {
        font-size: 1.8rem;
      }
      .event-info {
        flex-basis: 100%;
      }
      .page-hero {
        padding: 3rem 0 1.5rem;
      }
    }
  </style>
</Layout>
