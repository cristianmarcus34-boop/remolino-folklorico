---
import Layout from "../layouts/layout.astro";

export const prerender = false;
---

<Layout
    title="Acceso al panel | Remolino Folklórico"
    description="Acceso al panel de administración de Remolino Folklórico."
>
    <section class="login-section">
        <div class="login-card">
            <div class="login-brand">
                <span class="login-mark">R</span>
                <h1>Remolino</h1>
                <p>Panel de administración</p>
            </div>

            <form id="login-form" novalidate>
                <div class="login-field">
                    <label for="email">Email</label>
                    <input
                        id="email"
                        type="email"
                        name="email"
                        required
                        autocomplete="email"
                        placeholder="tu@email.com"
                        autofocus
                    />
                </div>

                <div class="login-field">
                    <label for="password">Contraseña</label>
                    <div class="password-wrap">
                        <input
                            id="password"
                            type="password"
                            name="password"
                            required
                            autocomplete="current-password"
                            placeholder="••••••••"
                        />
                        <button
                            type="button"
                            class="toggle-password"
                            id="toggle-password"
                            aria-label="Mostrar contraseña"
                            title="Mostrar contraseña"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"
                                ></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="login-btn" id="submit-btn">
                    <span class="btn-label">Entrar</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>

                <p
                    id="error-msg"
                    class="login-error"
                    role="alert"
                    style="display: none;"
                >
                </p>
            </form>

            <a href="/" class="login-back">← Volver al sitio</a>
        </div>
    </section>

    <script>
        const form = document.getElementById("login-form");
        const errorMsg = document.getElementById("error-msg");
        const submitBtn = document.getElementById("submit-btn");
        const toggleBtn = document.getElementById("toggle-password");

        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                const passInput = document.getElementById("password");
                if (!passInput || !("type" in passInput)) return;
                const isPassword = passInput.type === "password";
                passInput.type = isPassword ? "text" : "password";
                toggleBtn.setAttribute(
                    "aria-label",
                    isPassword ? "Ocultar contraseña" : "Mostrar contraseña",
                );
                toggleBtn.setAttribute(
                    "title",
                    isPassword ? "Ocultar contraseña" : "Mostrar contraseña",
                );
                toggleBtn.classList.toggle("is-visible", isPassword);
            });
        }

        if (form && errorMsg && submitBtn) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                errorMsg.textContent = "";

                const emailInput = document.getElementById("email");
                const passwordInput = document.getElementById("password");
                const email =
                    emailInput &&
                    "value" in emailInput &&
                    typeof emailInput.value === "string"
                        ? emailInput.value.trim()
                        : "";
                const password =
                    passwordInput && "value" in passwordInput
                        ? passwordInput.value
                        : "";

                if (!email || !password) {
                    errorMsg.textContent = "Completá email y contraseña.";
                    errorMsg.style.display = "block";
                    return;
                }

                submitBtn.setAttribute("disabled", "true");
                submitBtn.classList.add("is-loading");

                try {
                    const res = await fetch("/api/auth/sign-in/email", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ email, password }),
                    });

                    if (res.ok) {
                        window.location.href = "/admin";
                        return;
                    }

                    let message = "Credenciales inválidas";
                    try {
                        const data = await res.json();
                        if (data && data.message) message = data.message;
                    } catch (_) {
                        // si no vino JSON, dejamos el mensaje por defecto
                    }
                    errorMsg.textContent = message;
                    errorMsg.style.display = "block";
                } catch (err) {
                    errorMsg.textContent =
                        "Error de conexión. Intentá de nuevo.";
                    errorMsg.style.display = "block";
                } finally {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.classList.remove("is-loading");
                }
            });
        }
    </script>

    <style>
        .login-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1.2rem;
            background:
                radial-gradient(
                    ellipse 60% 50% at 30% 20%,
                    rgba(199, 91, 57, 0.18),
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 50% 40% at 70% 80%,
                    rgba(212, 168, 83, 0.12),
                    transparent 70%
                );
        }
        .login-card {
            max-width: 420px;
            width: 100%;
            background: var(--bg-soft);
            border: 1px solid rgba(212, 168, 83, 0.18);
            border-radius: 8px;
            padding: 2.5rem;
            box-shadow:
                0 24px 70px rgba(0, 0, 0, 0.45),
                inset 0 1px 0 rgba(255, 255, 255, 0.02);
            position: relative;
            overflow: hidden;
        }
        .login-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 2px;
            background: linear-gradient(
                90deg,
                transparent,
                var(--accent-soft),
                transparent
            );
            opacity: 0.6;
        }
        .login-brand {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            background: var(--accent);
            color: var(--text);
            border-radius: 50%;
            font-family: var(--font-serif);
            font-size: 1.6rem;
            font-weight: 600;
            margin-bottom: 1rem;
            box-shadow: 0 8px 24px rgba(199, 91, 57, 0.35);
        }
        .login-brand h1 {
            font-family: var(--font-serif);
            font-size: 1.9rem;
            font-weight: 400;
            margin-bottom: 0.3rem;
            letter-spacing: -0.02em;
        }
        .login-brand p {
            color: var(--text-muted);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }
        .login-field {
            margin-bottom: 1.2rem;
        }
        .login-field label {
            display: block;
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-bottom: 0.45rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }
        .login-field input {
            width: 100%;
            padding: 0.85rem 1rem;
            background: var(--bg);
            border: 1px solid rgba(212, 168, 83, 0.2);
            color: var(--text);
            border-radius: 3px;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            transition:
                border-color 0.2s ease,
                background 0.2s ease,
                box-shadow 0.2s ease;
        }
        .login-field input:focus {
            outline: none;
            border-color: var(--accent-soft);
            background: var(--bg-soft);
            box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.12);
        }
        .login-field input::placeholder {
            color: var(--text-muted);
            opacity: 0.55;
        }
        .password-wrap {
            position: relative;
        }
        .password-wrap input {
            padding-right: 2.8rem;
        }
        .toggle-password {
            position: absolute;
            top: 50%;
            right: 0.7rem;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.3rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 2px;
            transition:
                color 0.2s ease,
                background 0.2s ease;
        }
        .toggle-password:hover {
            color: var(--accent-soft);
            background: rgba(212, 168, 83, 0.08);
        }
        .toggle-password.is-visible {
            color: var(--accent-soft);
        }
        .login-btn {
            width: 100%;
            background: var(--accent);
            color: var(--text);
            border: none;
            padding: 0.95rem;
            border-radius: 3px;
            font-size: 0.8rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            font-weight: 500;
            cursor: pointer;
            transition:
                background 0.3s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
            font-family: var(--font-sans);
            margin-top: 0.5rem;
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            min-height: 48px;
        }
        .login-btn:hover:not(:disabled) {
            background: #a84a2d;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(199, 91, 57, 0.3);
        }
        .login-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
        .btn-spinner {
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(245, 240, 232, 0.3);
            border-top-color: var(--text);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }
        .login-btn.is-loading .btn-spinner {
            display: inline-block;
        }
        .login-btn.is-loading .btn-label {
            opacity: 0.8;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
        .login-error {
            color: #ff8a7a;
            font-size: 0.85rem;
            margin-top: 1rem;
            padding: 0.7rem 0.9rem;
            background: rgba(231, 76, 60, 0.1);
            border-left: 3px solid #e74c3c;
            border-radius: 2px;
            line-height: 1.4;
        }
        .login-back {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            transition: color 0.2s;
        }
        .login-back:hover {
            color: var(--accent-soft);
        }
        @media (max-width: 480px) {
            .login-card {
                padding: 2rem 1.5rem;
            }
            .login-brand h1 {
                font-size: 1.6rem;
            }
            .login-mark {
                width: 48px;
                height: 48px;
                font-size: 1.4rem;
            }
        }
    </style>
</Layout>
