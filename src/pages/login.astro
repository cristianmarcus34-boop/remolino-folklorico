---
import Layout from "../layouts/layout.astro";

export const prerender = false;
---

<Layout title="Login | Remolino Folklórico">
    <section class="login-section">
        <div class="login-card">
            <div class="login-brand">
                <span class="login-mark">R</span>
                <h1>Remolino</h1>
                <p>Panel de administración</p>
            </div>

            <form id="login-form">
                <div class="login-field">
                    <label for="email">Email</label>
                    <input
                        id="email"
                        type="email"
                        name="email"
                        required
                        autocomplete="email"
                        placeholder="tu@email.com"
                    />
                </div>
                <div class="login-field">
                    <label for="password">Contraseña</label>
                    <input
                        id="password"
                        type="password"
                        name="password"
                        required
                        autocomplete="current-password"
                        placeholder="••••••••"
                    />
                </div>
                <button type="submit" class="login-btn" id="submit-btn"
                    >Entrar</button
                >
                <p id="error-msg" class="login-error" style="display: none;">
                </p>
            </form>

            <a href="/" class="login-back">← Volver al sitio</a>
        </div>
    </section>

    <script>
        const form = document.getElementById("login-form");
        const errorMsg = document.getElementById("error-msg");
        const submitBtn = document.getElementById("submit-btn");

        if (form && errorMsg && submitBtn) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                submitBtn.setAttribute("disabled", "true");
                submitBtn.textContent = "Entrando...";

                const emailInput = document.getElementById("email");
                const passwordInput = document.getElementById("password");
                const email =
                    emailInput && "value" in emailInput ? emailInput.value : "";
                const password =
                    passwordInput && "value" in passwordInput
                        ? passwordInput.value
                        : "";
                try {
                    const res = await fetch("/api/auth/sign-in/email", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        credentials: "include",
                        body: JSON.stringify({ email, password }),
                    });

                    if (res.ok) {
                        window.location.href = "/admin";
                    } else {
                        const data = await res.json();
                        errorMsg.textContent =
                            data.message || "Credenciales inválidas";
                        errorMsg.style.display = "block";
                        submitBtn.removeAttribute("disabled");
                        submitBtn.textContent = "Entrar";
                    }
                } catch (err) {
                    errorMsg.textContent = "Error de conexión";
                    errorMsg.style.display = "block";
                    submitBtn.removeAttribute("disabled");
                    submitBtn.textContent = "Entrar";
                }
            });
        }
    </script>

    <style>
        .login-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background:
                radial-gradient(
                    ellipse 60% 50% at 30% 20%,
                    rgba(199, 91, 57, 0.15),
                    transparent 70%
                ),
                radial-gradient(
                    ellipse 50% 40% at 70% 80%,
                    rgba(212, 168, 83, 0.1),
                    transparent 70%
                );
        }
        .login-card {
            max-width: 420px;
            width: 100%;
            background: var(--bg-soft);
            border: 1px solid rgba(212, 168, 83, 0.15);
            border-radius: 6px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        }
        .login-brand {
            text-align: center;
            margin-bottom: 2rem;
        }
        .login-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            background: var(--accent);
            color: var(--text);
            border-radius: 50%;
            font-family: var(--font-serif);
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        .login-brand h1 {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            margin-bottom: 0.3rem;
        }
        .login-brand p {
            color: var(--text-muted);
            font-size: 0.85rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
        .login-field {
            margin-bottom: 1.2rem;
        }
        .login-field label {
            display: block;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .login-field input {
            width: 100%;
            padding: 0.85rem 1rem;
            background: var(--bg);
            border: 1px solid rgba(212, 168, 83, 0.2);
            color: var(--text);
            border-radius: 3px;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            transition:
                border-color 0.2s ease,
                background 0.2s ease;
        }
        .login-field input:focus {
            outline: none;
            border-color: var(--accent-soft);
            background: var(--bg-soft);
        }
        .login-field input::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }
        .login-btn {
            width: 100%;
            background: var(--accent);
            color: var(--text);
            border: none;
            padding: 0.95rem;
            border-radius: 3px;
            font-size: 0.85rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            font-weight: 500;
            cursor: pointer;
            transition:
                background 0.3s ease,
                transform 0.2s ease;
            font-family: var(--font-sans);
            margin-top: 0.5rem;
        }
        .login-btn:hover:not(:disabled) {
            background: #a84a2d;
            transform: translateY(-1px);
        }
        .login-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .login-error {
            color: #ff8a7a;
            font-size: 0.85rem;
            margin-top: 1rem;
            padding: 0.7rem;
            background: rgba(231, 76, 60, 0.1);
            border-left: 3px solid #e74c3c;
            border-radius: 2px;
        }
        .login-back {
            display: block;
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            transition: color 0.2s;
        }
        .login-back:hover {
            color: var(--accent-soft);
        }
    </style>
</Layout>
