---
// src/pages/galeria.astro
import "../styles/global.css";
import Layout from "../layouts/layout.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { db } from "../db/index.js";
import { galeria } from "../db/schema.js";
import { desc } from "drizzle-orm";

export const prerender = false;

const imagenes = await db.select().from(galeria).orderBy(desc(galeria.id));
const destacada =
  imagenes.find((i) => i.seccion === "galeria_destacada") || null;
const resto = imagenes.filter((i) => i.id !== destacada?.id);
---

<Layout title="Galería | Remolino Folklórico">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">Nuestro trabajo</p>
      <h1>Galería</h1>
    </div>
  </section>

  <section>
    <div class="container reveal">
      {
        imagenes.length === 0 ? (
          <p style="color: var(--text-muted); font-style: italic;">
            Próximamente fotos de nuestras presentaciones.
          </p>
        ) : (
          <div class="gallery">
            {destacada && (
              <div class="gallery-item gallery-item-large">
                <img
                  src={destacada.url}
                  alt={destacada.alt}
                  loading="eager"
                  decoding="async"
                />
              </div>
            )}
            {resto.map((img) => (
              <div class="gallery-item">
                <img
                  src={img.url}
                  alt={img.alt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <ScrollReveal />

  <style>
    .page-hero {
      padding: 6rem 0 3rem;
      background: radial-gradient(
        ellipse at top,
        rgba(199, 91, 57, 0.12),
        transparent 60%
      );
    }
    .kicker {
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 0.8rem;
      color: var(--accent-soft);
      margin-bottom: 1rem;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .gallery-item {
      overflow: hidden;
      border-radius: 2px;
      background: var(--bg-soft);
    }
    .gallery-item img {
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .gallery-item:hover img {
      transform: scale(1.05);
    }
    .gallery-item-large {
      grid-column: span 2;
      grid-row: span 2;
    }
    .gallery-item-large img {
      aspect-ratio: auto;
      height: 100%;
    }
    @media (max-width: 768px) {
      .gallery {
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
      }
      .gallery-item-large {
        grid-column: span 2;
        grid-row: span 1;
      }
      .page-hero {
        padding: 4rem 0 2rem;
      }
    }
    @media (max-width: 480px) {
      .gallery {
        grid-template-columns: 1fr;
      }
      .gallery-item-large {
        grid-column: span 1;
      }
      .page-hero {
        padding: 3rem 0 1.5rem;
      }
    }
  </style>
</Layout>
