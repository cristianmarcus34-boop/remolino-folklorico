---
// src/pages/index.astro
import "../styles/global.css";
import Layout from "../layouts/layout.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import RemolinoCanvas from "../components/RemolinoCanvas.astro";
---

<Layout title="Inicio | Remolino Folklórico">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="hero-kicker hero-anim hero-anim-1">Danza folclórica</p>
        <h1 class="hero-anim hero-anim-2">Remolino<br />Folklórico</h1>
        <p class="hero-text hero-anim hero-anim-3">
          Un grupo dedicado a mantener viva la tradición a través de la danza,
          el color y la música de nuestra tierra.
        </p>
        <a href="/eventos" class="btn hero-anim hero-anim-4"
          >Ver próximos eventos</a
        >
      </div>
      <div class="hero-visual hero-anim hero-anim-3">
        <RemolinoCanvas />
      </div>
    </div>
  </section>

  <section class="intro">
    <div class="container intro-grid">
      <div class="reveal">
        <h2>Tradición en movimiento</h2>
        <p>
          Somos un grupo de bailarines que lleva el folclor a cada escenario.
          Con años de experiencia y pasión por nuestras raíces, compartimos la
          cultura a través de coreografías que emocionan.
        </p>
        <a href="/nosotros" class="link-arrow">Conocé más sobre nosotros →</a>
      </div>
      <div class="intro-image reveal">
        <div class="placeholder">Foto del grupo</div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container reveal">
      <h2>¿Querés que bailemos en tu evento?</h2>
      <p>Escribinos y coordinamos una presentación.</p>
      <a href="mailto:contacto@remolino.com" class="btn">Contactar</a>
    </div>
  </section>

  <ScrollReveal />

  <style>
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      padding: 6rem 0;
      background:
        radial-gradient(
          ellipse 80% 60% at 20% 30%,
          rgba(199, 91, 57, 0.12),
          transparent 70%
        ),
        radial-gradient(
          ellipse 60% 50% at 80% 70%,
          rgba(212, 168, 83, 0.08),
          transparent 70%
        );
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: center;
      width: 100%;
    }
    .hero-content {
      position: relative;
      z-index: 1;
    }
    .hero-visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      max-height: 600px;
    }
    .hero-kicker {
      text-transform: uppercase;
      letter-spacing: 0.35em;
      font-size: 0.7rem;
      color: var(--accent-soft);
      margin-bottom: 2rem;
      font-weight: 500;
    }
    .hero h1 {
      margin-bottom: 2rem;
      max-width: 900px;
    }
    .hero-text {
      max-width: 480px;
      color: var(--text-muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 3rem;
      font-weight: 300;
    }
    .btn {
      display: inline-block;
      background: var(--accent);
      color: var(--text);
      padding: 1rem 2.4rem;
      border-radius: 2px;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
      transition:
        background 0.3s ease,
        transform 0.2s ease;
    }
    .btn:hover {
      background: #a84a2d;
      color: var(--text);
      transform: translateY(-2px);
    }
    .intro-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
    .intro p {
      color: var(--text-muted);
      margin-bottom: 1.8rem;
      font-weight: 300;
      line-height: 1.7;
    }
    .link-arrow {
      font-size: 0.9rem;
      color: var(--accent-soft);
      letter-spacing: 0.02em;
    }
    .placeholder {
      aspect-ratio: 4 / 5;
      background: var(--bg-soft);
      border: 1px dashed rgba(212, 168, 83, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-style: italic;
      font-weight: 300;
    }
    .cta {
      background: var(--bg-soft);
      text-align: center;
    }
    .cta p {
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      font-weight: 300;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hero-visual {
        order: 2;
        max-height: 380px;
      }
      .hero-content {
        order: 1;
      }
      .intro-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 600px) {
      .hero {
        min-height: auto;
        padding: 3rem 0 4rem;
      }
      .hero-kicker {
        font-size: 0.62rem;
        letter-spacing: 0.25em;
        margin-bottom: 1.2rem;
      }
      .hero h1 {
        margin-bottom: 1.2rem;
      }
      .hero-text {
        font-size: 1rem;
        margin-bottom: 2rem;
      }
      .hero-visual {
        max-height: 300px;
      }
      .btn {
        padding: 0.9rem 1.8rem;
        font-size: 0.75rem;
      }
      .cta p {
        margin-bottom: 1.8rem;
      }
    }
  </style>
</Layout>
