---
// src/pages/index.astro
import "../styles/global.css";
import Layout from "../layouts/layout.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import RemolinoCanvas from "../components/RemolinoCanvas.astro";
import { db } from "../db/index.js";
import { galeria } from "../db/schema.js";

export const prerender = false;

const imagenes = await db.select().from(galeria);
const fotoInicio =
  imagenes
    .filter((f) => f.seccion === "inicio")
    .sort((a, b) => b.id - a.id)[0] || null;
---

<Layout
  title="Remolino Folklórico | Ballet folclórico de mujeres"
  description="Ballet folclórico integrado por mujeres. Nacimos en 2025 del encuentro entre amigas unidas por la pasión por nuestras danzas. Conocé nuestras presentaciones y talleres."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="hero-kicker hero-anim hero-anim-1">Ballet folclórico</p>
        <h1 class="hero-anim hero-anim-2">
          Remolino<br /><span class="hero-accent">Folklórico</span>
        </h1>
        <p class="hero-text hero-anim hero-anim-3">
          Mujeres unidas por la danza, la amistad y el amor por nuestras
          tradiciones. Un espacio propio para expresarnos y mantener vivas
          nuestras raíces culturales.
        </p>
        <div class="hero-actions hero-anim hero-anim-4">
          <a href="/eventos" class="btn">Ver próximos eventos</a>
          <a href="/nosotros" class="link-ghost">Conocé el grupo →</a>
        </div>
      </div>
      <div class="hero-visual hero-anim hero-anim-3">
        <RemolinoCanvas />
      </div>
    </div>
    <div class="hero-scroll">
      <span>Deslizá</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <section class="intro">
    <div class="container intro-grid">
      <div class="reveal">
        <p class="section-kicker">Nuestra esencia</p>
        <h2>Tradición en movimiento</h2>
        <p>
          Nacimos el 8 de noviembre de 2025, del encuentro entre amigas que
          querían volver a bailar juntas. Hoy somos un ballet integrado
          exclusivamente por mujeres, que lleva el folclor a cada escenario y
          crece al ritmo de nuestras raíces.
        </p>
        <a href="/nosotros" class="link-arrow">Conocé nuestra historia →</a>
      </div>
      <div class="intro-image reveal">
        {
          fotoInicio ? (
            <div class="intro-photo">
              <img
                src={fotoInicio.url}
                alt={fotoInicio.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="placeholder">Foto del grupo</div>
          )
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container reveal">
      <p class="section-kicker">Contrataciones</p>
      <h2>¿Querés que bailemos en tu evento?</h2>
      <p>Escribinos por WhatsApp y coordinamos una presentación.</p>
      <div class="cta-actions">
        <a
          href="https://wa.me/5491128386926?text=Hola%2C%20los%20contacto%20desde%20la%20web%20de%20Remolino%20Folkl%C3%B3rico.%20Quisiera%20consultar%20por%20una%20presentaci%C3%B3n."
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
          Escribinos por WhatsApp
        </a>
        <a href="/contrataciones" class="link-ghost"
          >Ver opciones de contratación →</a
        >
      </div>
    </div>
  </section>

  <ScrollReveal />

  <style>
    .hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: center;
      padding: 6rem 0 8rem;
      overflow: hidden;
      background:
        radial-gradient(
          ellipse 70% 60% at 15% 25%,
          rgba(199, 91, 57, 0.18),
          transparent 65%
        ),
        radial-gradient(
          ellipse 60% 50% at 85% 75%,
          rgba(212, 168, 83, 0.12),
          transparent 65%
        );
    }
    .hero::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(212, 168, 83, 0.25),
        transparent
      );
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: center;
      width: 100%;
    }
    .hero-content {
      position: relative;
      z-index: 1;
    }
    .hero-visual {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      max-height: 600px;
    }
    .hero-kicker {
      text-transform: uppercase;
      letter-spacing: 0.35em;
      font-size: 0.7rem;
      color: var(--accent-soft);
      margin-bottom: 2rem;
      font-weight: 500;
    }
    .hero h1 {
      margin-bottom: 2rem;
      max-width: 900px;
      font-weight: 300;
    }
    .hero-accent {
      font-style: italic;
      color: var(--accent-soft);
    }
    .hero-text {
      max-width: 480px;
      color: var(--text-muted);
      font-size: 1.1rem;
      line-height: 1.75;
      margin-bottom: 2.5rem;
      font-weight: 300;
    }
    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      background: var(--accent);
      color: var(--text);
      padding: 1rem 2.4rem;
      border-radius: 2px;
      font-size: 0.8rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 500;
      transition:
        background 0.3s ease,
        transform 0.2s ease;
    }
    .btn svg {
      display: block;
      flex-shrink: 0;
      position: relative;
      top: 1px;
    }
    .btn:hover {
      background: #a84a2d;
      color: var(--text);
      transform: translateY(-2px);
    }
    .link-ghost {
      font-size: 0.9rem;
      color: var(--text-muted);
      letter-spacing: 0.02em;
      transition: color 0.2s ease;
    }
    .link-ghost:hover {
      color: var(--accent-soft);
    }
    .hero-scroll {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      opacity: 0.5;
    }
    .hero-scroll span {
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .hero-scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, var(--accent-soft), transparent);
    }

    .section-kicker {
      text-transform: uppercase;
      letter-spacing: 0.3em;
      font-size: 0.7rem;
      color: var(--accent-soft);
      margin-bottom: 1rem;
      font-weight: 500;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
    .intro h2 {
      margin-bottom: 1.5rem;
    }
    .intro p {
      color: var(--text-muted);
      margin-bottom: 1.8rem;
      font-weight: 300;
      line-height: 1.75;
    }
    .link-arrow {
      font-size: 0.9rem;
      color: var(--accent-soft);
      letter-spacing: 0.02em;
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .link-arrow:hover {
      transform: translateX(4px);
    }
    .intro-photo {
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      aspect-ratio: 4 / 5;
    }
    .intro-photo::after {
      content: "";
      position: absolute;
      inset: 0;
      border: 1px solid rgba(212, 168, 83, 0.25);
      border-radius: 4px;
      pointer-events: none;
    }
    .intro-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .intro-photo:hover img {
      transform: scale(1.04);
    }
    .placeholder {
      aspect-ratio: 4 / 5;
      background: var(--bg-soft);
      border: 1px dashed rgba(212, 168, 83, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-style: italic;
      font-weight: 300;
      border-radius: 4px;
    }

    .cta {
      background: var(--bg-soft);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        ellipse 50% 80% at 50% 0%,
        rgba(199, 91, 57, 0.1),
        transparent 70%
      );
      pointer-events: none;
    }
    .cta .container {
      position: relative;
      z-index: 1;
    }
    .cta h2 {
      margin-bottom: 1rem;
    }
    .cta p {
      color: var(--text-muted);
      margin-bottom: 2.5rem;
      font-weight: 300;
    }
    .cta-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hero-visual {
        order: 2;
        max-height: 380px;
      }
      .hero-content {
        order: 1;
      }
      .hero-scroll {
        display: none;
      }
      .intro-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
    }

    @media (max-width: 600px) {
      .hero {
        min-height: auto;
        padding: 3rem 0 4rem;
      }
      .hero-kicker {
        font-size: 0.62rem;
        letter-spacing: 0.25em;
        margin-bottom: 1.2rem;
      }
      .hero h1 {
        margin-bottom: 1.2rem;
      }
      .hero-text {
        font-size: 1rem;
        margin-bottom: 2rem;
      }
      .hero-visual {
        max-height: 300px;
      }
      .hero-actions {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .btn {
        padding: 0.9rem 1.8rem;
        font-size: 0.75rem;
      }
      .cta p {
        margin-bottom: 1.8rem;
      }
      .cta-actions {
        flex-direction: column;
        gap: 1rem;
      }
    }
  </style>
</Layout>
