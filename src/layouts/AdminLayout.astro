---
import "../styles/global.css";
import { db } from "../db/index.js";
import { mensajes, user } from "../db/schema.js";
import { eq } from "drizzle-orm";
import Toast from "../components/Toast.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";

const { title = "Panel | Remolino Folklórico" } = Astro.props;
const session = Astro.locals.session;
const currentPath = Astro.url.pathname;

let noLeidos = 0;
let esAdmin = false;

if (session) {
    const pendientes = await db
        .select()
        .from(mensajes)
        .where(eq(mensajes.leido, false));
    noLeidos = pendientes.length;

    const [usuarioActual] = await db
        .select()
        .from(user)
        .where(eq(user.id, session.user.id));
    esAdmin = usuarioActual?.role === "admin";
}
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>
    <body>
        <header class="admin-header">
            <div class="container admin-header-inner">
                <a href="/admin" class="admin-logo">
                    <img
                        src="/favicon-32x32.png"
                        alt=""
                        class="admin-logo-mark"
                        width="32"
                        height="32"
                    />
                    <span
                        >Remolino <span class="admin-logo-sub">Panel</span
                        ></span
                    >
                </a>

                <nav class="admin-nav">
                    <!-- 👇 AYUDA PRIMERO -->
                    <a
                        href="/admin/ayuda"
                        class:list={[
                            {
                                active: currentPath.startsWith("/admin/ayuda"),
                            },
                        ]}>Ayuda</a
                    >
                    <a
                        href="/admin"
                        class:list={[{ active: currentPath === "/admin" }]}
                        >Eventos</a
                    >
                    <a
                        href="/admin/videos"
                        class:list={[
                            {
                                active: currentPath.startsWith("/admin/videos"),
                            },
                        ]}>Videos</a
                    >
                    <a
                        href="/admin/galeria"
                        class:list={[
                            {
                                active: currentPath.startsWith(
                                    "/admin/galeria",
                                ),
                            },
                        ]}>Galería</a
                    >
                    <a
                        href="/admin/mensajes"
                        class:list={[
                            {
                                active: currentPath.startsWith(
                                    "/admin/mensajes",
                                ),
                            },
                        ]}
                    >
                        Mensajes
                        {
                            noLeidos > 0 && (
                                <span class="nav-badge">{noLeidos}</span>
                            )
                        }
                    </a>
                    {
                        esAdmin && (
                            <a
                                href="/admin/usuarios"
                                class:list={[
                                    {
                                        active: currentPath.startsWith(
                                            "/admin/usuarios",
                                        ),
                                    },
                                ]}
                            >
                                Usuarios
                            </a>
                        )
                    }
                </nav>

                <div class="admin-user">
                    <span class="admin-user-email">{session?.user?.email}</span>
                    <a href="/" class="admin-back-btn" title="Volver al sitio">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M19 12H5M12 19l-7-7 7-7"></path>
                        </svg>
                        Volver al sitio
                    </a>
                    <button id="logout-btn" class="admin-logout-btn">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"
                            ></path>
                        </svg>
                        Cerrar sesión
                    </button>
                </div>
            </div>
        </header>

        <main>
            <slot />
        </main>

        <Toast />
        <ConfirmDialog />

        <script>
            const logoutBtn = document.getElementById("logout-btn");
            if (logoutBtn) {
                logoutBtn.addEventListener("click", async () => {
                    await fetch("/api/auth/sign-out", {
                        method: "POST",
                        credentials: "include",
                    });
                    window.location.href = "/login";
                });
            }
        </script>

        <style>
            .admin-header {
                background: rgba(0, 0, 0, 0.75);
                backdrop-filter: blur(16px) saturate(180%);
                -webkit-backdrop-filter: blur(16px) saturate(180%);
                border-bottom: 1px solid rgba(233, 30, 99, 0.15);
                position: sticky;
                top: 0;
                z-index: 100;
            }
            .admin-header-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
                padding-top: 0.9rem;
                padding-bottom: 0.9rem;
                flex-wrap: wrap;
            }
            .admin-logo {
                display: flex;
                align-items: center;
                gap: 0.7rem;
                font-family: var(--font-serif);
                font-size: 1.1rem;
                color: var(--text);
                font-weight: 500;
            }
            .admin-logo-mark {
                display: inline-block;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                box-shadow:
                    0 0 15px rgba(233, 30, 99, 0.4),
                    0 0 30px rgba(255, 202, 40, 0.2);
            }
            .admin-logo-sub {
                color: var(--text-muted);
                font-size: 0.85rem;
                font-family: var(--font-sans);
                font-weight: 400;
            }
            .admin-nav {
                display: flex;
                gap: 1.5rem;
                align-items: center;
                flex-wrap: wrap;
            }
            .admin-nav a {
                color: var(--text-muted);
                font-size: 0.9rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                padding: 0.4rem 0;
                border-bottom: 1px solid transparent;
                transition:
                    color 0.2s,
                    border-color 0.2s;
            }
            .admin-nav a:hover {
                color: var(--accent-soft);
            }
            .admin-nav a.active {
                color: var(--accent-soft);
                border-bottom-color: var(--accent-soft);
            }
            .nav-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 18px;
                height: 18px;
                padding: 0 0.4rem;
                background: var(--accent);
                color: #ffffff;
                border-radius: 9px;
                font-size: 0.65rem;
                font-weight: 600;
                line-height: 1;
            }
            .admin-user {
                display: flex;
                align-items: center;
                gap: 0.8rem;
                font-size: 0.8rem;
                color: var(--text-muted);
            }
            .admin-user-email {
                max-width: 160px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }
            .admin-back-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                background: rgba(233, 30, 99, 0.1);
                border: 1px solid rgba(233, 30, 99, 0.3);
                color: var(--accent);
                padding: 0.45rem 0.9rem;
                border-radius: 2px;
                font-size: 0.75rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.2s;
                text-decoration: none;
            }
            .admin-back-btn:hover {
                background: rgba(233, 30, 99, 0.2);
                border-color: var(--accent);
                color: #ffffff;
            }
            .admin-logout-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                background: none;
                border: 1px solid rgba(255, 202, 40, 0.3);
                color: var(--text-muted);
                padding: 0.45rem 0.9rem;
                border-radius: 2px;
                font-size: 0.75rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.2s;
            }
            .admin-logout-btn:hover {
                border-color: var(--accent-soft);
                color: var(--accent-soft);
            }
            @media (max-width: 900px) {
                .admin-header-inner {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.7rem;
                }
                .admin-nav {
                    gap: 1rem;
                }
                .admin-user {
                    width: 100%;
                    justify-content: space-between;
                    flex-wrap: wrap;
                }
                .admin-user-email {
                    display: none;
                }
            }
        </style>
    </body>
</html>
