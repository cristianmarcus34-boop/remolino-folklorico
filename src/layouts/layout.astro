---
// src/layouts/layout.astro
const { title = "Remolino Folklórico" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta
      name="description"
      content="Remolino Folklórico - Grupo de danza folclórica"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">Remolino Folklórico</a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/galeria">Galería</a>
          <a href="/eventos">Eventos</a>
          <a
            href="/admin"
            class="admin-link"
            title="Panel de administración"
            aria-label="Panel de administración"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; 2026 Remolino Folklórico. Todos los derechos reservados.</p>
        <p class="footer-admin">
          <a href="/admin">Panel de administración</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(26, 20, 16, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(212, 168, 83, 0.1);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .logo {
        font-family: var(--font-serif);
        font-size: 1.35rem;
        color: var(--text);
        letter-spacing: -0.01em;
        font-weight: 500;
      }
      nav {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      nav a {
        color: var(--text-muted);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
      }
      nav a:hover {
        color: var(--accent-soft);
      }
      nav a.admin-link {
        display: inline-flex;
        align-items: center;
        opacity: 0.5;
        transition:
          opacity 0.2s ease,
          color 0.2s ease;
      }
      nav a.admin-link:hover {
        opacity: 1;
        color: var(--accent-soft);
      }
      .site-footer {
        border-top: 1px solid rgba(212, 168, 83, 0.1);
        padding: 2.5rem 0;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }
      .footer-admin {
        margin-top: 0.8rem;
        font-size: 0.7rem;
        opacity: 0.5;
        transition: opacity 0.2s ease;
      }
      .footer-admin:hover {
        opacity: 0.9;
      }
      .footer-admin a {
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .footer-admin a:hover {
        color: var(--accent-soft);
      }
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          gap: 0.6rem;
          padding-top: 0.9rem;
          padding-bottom: 0.9rem;
        }
        .logo {
          font-size: 1.15rem;
        }
        nav {
          gap: 0.9rem;
          flex-wrap: wrap;
          justify-content: center;
        }
        nav a {
          font-size: 0.8rem;
        }
        .site-footer {
          padding: 2rem 0;
          font-size: 0.75rem;
        }
      }
    </style>
  </body>
</html>
