---
// src/layouts/layout.astro
import "../styles/global.css";

const {
  title = "Remolino Folklórico",
  description = "Ballet folclórico integrado por mujeres. Tradición, amistad y amor por nuestras danzas en cada escenario.",
  image = "https://remolino-folklorico.vercel.app/og-default.jpeg",
  url = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Remolino Folklórico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo" aria-label="Remolino Folklórico - Inicio">
          <img
            src="/favicon-32x32.png"
            alt=""
            class="logo-mark-img"
            width="32"
            height="32"
          />
          <span class="logo-text"
            >Remolino <span class="logo-sub">Folklórico</span></span
          >
        </a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/galeria">Galería</a>
          <a href="/eventos">Eventos</a>
          <a href="/videos">Videos</a>
          <a href="/contrataciones">Contrataciones</a>
          <a
            href="/admin"
            class="admin-link"
            title="Panel de administración"
            aria-label="Panel de administración"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-glow"></div>
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo">
            <img
              src="/favicon-32x32.png"
              alt=""
              class="logo-mark-img"
              width="32"
              height="32"
            />
            <span class="logo-text"
              >Remolino <span class="logo-sub">Folklórico</span></span
            >
          </a>
          <p class="footer-tagline">
            Mujeres unidas por la danza, la amistad y el amor por nuestras
            tradiciones.
          </p>
        </div>

        <div class="footer-nav">
          <a href="/">Inicio</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/galeria">Galería</a>
          <a href="/eventos">Eventos</a>
          <a href="/videos">Videos</a>
          <a href="/contrataciones">Contrataciones</a>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2026 Remolino Folklórico. Todos los derechos reservados.</p>
          <a href="/admin" class="footer-admin">Panel de administración</a>
        </div>
      </div>
    </footer>

    <style>
      /* ============================
         HEADER
         ============================ */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(26, 20, 16, 0.75);
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border-bottom: 1px solid rgba(212, 168, 83, 0.08);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-family: var(--font-serif);
        font-size: 1.2rem;
        color: var(--text);
        letter-spacing: -0.01em;
        font-weight: 500;
        transition: opacity 0.2s ease;
      }
      .logo:hover {
        color: var(--text);
        opacity: 0.85;
      }
      .logo-mark-img {
        display: inline-block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        flex-shrink: 0;
        box-shadow: 0 4px 16px rgba(199, 91, 57, 0.35);
        object-fit: cover;
      }
      .logo-text {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
      }
      .logo-sub {
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 400;
        color: var(--text-muted);
        letter-spacing: 0.02em;
      }
      nav {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      nav a {
        color: var(--text-muted);
        font-size: 0.88rem;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
        position: relative;
      }
      nav a:hover {
        color: var(--accent-soft);
      }
      nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 100%;
        height: 1px;
        background: var(--accent-soft);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      nav a:hover::after {
        transform: scaleX(1);
        transform-origin: left;
      }
      nav a.admin-link {
        display: inline-flex;
        align-items: center;
        opacity: 0.4;
        transition:
          opacity 0.2s ease,
          color 0.2s ease;
      }
      nav a.admin-link::after {
        display: none;
      }
      nav a.admin-link:hover {
        opacity: 1;
        color: var(--accent-soft);
      }

      /* ============================
         FOOTER
         ============================ */
      .site-footer {
        position: relative;
        background: var(--bg-soft);
        border-top: 1px solid rgba(212, 168, 83, 0.1);
        padding: 4rem 0 2rem;
        overflow: hidden;
      }
      .footer-glow {
        position: absolute;
        top: -200px;
        left: 50%;
        transform: translateX(-50%);
        width: 600px;
        height: 400px;
        background: radial-gradient(
          ellipse,
          rgba(199, 91, 57, 0.12),
          transparent 70%
        );
        filter: blur(60px);
        pointer-events: none;
      }
      .footer-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 3rem;
      }
      .footer-brand {
        text-align: center;
      }
      .footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        font-family: var(--font-serif);
        font-size: 1.2rem;
        color: var(--text);
        font-weight: 500;
        margin-bottom: 1rem;
      }
      .footer-logo:hover {
        color: var(--text);
      }
      .footer-tagline {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--accent-soft);
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.6;
      }
      .footer-nav {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 2rem;
        padding: 2rem 0;
        border-top: 1px solid rgba(212, 168, 83, 0.08);
        border-bottom: 1px solid rgba(212, 168, 83, 0.08);
      }
      .footer-nav a {
        color: var(--text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
      }
      .footer-nav a:hover {
        color: var(--accent-soft);
      }
      .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        opacity: 0.7;
      }
      .footer-admin {
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-muted);
        transition:
          color 0.2s ease,
          opacity 0.2s ease;
        opacity: 0.6;
      }
      .footer-admin:hover {
        color: var(--accent-soft);
        opacity: 1;
      }

      /* ============================
         RESPONSIVE
         ============================ */
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          gap: 0.8rem;
          padding-top: 0.9rem;
          padding-bottom: 0.9rem;
        }
        .logo {
          font-size: 1.05rem;
        }
        .logo-mark {
          width: 28px;
          height: 28px;
          font-size: 0.85rem;
        }
        .logo-sub {
          font-size: 0.7rem;
        }
        nav {
          gap: 1rem;
          flex-wrap: wrap;
          justify-content: center;
        }
        nav a {
          font-size: 0.8rem;
        }
        .site-footer {
          padding: 3rem 0 1.5rem;
        }
        .footer-tagline {
          font-size: 0.95rem;
        }
        .footer-nav {
          gap: 1.2rem;
          padding: 1.5rem 0;
        }
        .footer-nav a {
          font-size: 0.8rem;
        }
        .footer-bottom {
          flex-direction: column;
          text-align: center;
          gap: 0.8rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        nav a::after {
          display: none;
        }
      }
    </style>
  </body>
</html>
