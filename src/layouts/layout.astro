---
// src/layouts/layout.astro
import "../styles/global.css";
const {
  title = "Remolino Folklórico",
  description = "Ballet folclórico integrado por mujeres. Tradición, amistad y amor por nuestras danzas en cada escenario.",
  image = "https://remolino-folklorico.vercel.app/og-default.jpeg",
  url = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph (WhatsApp, Facebook, Instagram, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Remolino Folklórico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">Remolino Folklórico</a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/galeria">Galería</a>
          <a href="/eventos">Eventos</a>
          <a href="/contrataciones">Contrataciones</a>
          <a
            href="/admin"
            class="admin-link"
            title="Panel de administración"
            aria-label="Panel de administración"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-tagline">
          Mujeres unidas por la danza, la amistad y el amor por nuestras
          tradiciones.
        </p>
        <p>&copy; 2026 Remolino Folklórico. Todos los derechos reservados.</p>
        <p class="footer-admin">
          <a href="/admin">Panel de administración</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(26, 20, 16, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(212, 168, 83, 0.1);
      }
      .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.1rem;
        padding-bottom: 1.1rem;
      }
      .logo {
        font-family: var(--font-serif);
        font-size: 1.35rem;
        color: var(--text);
        letter-spacing: -0.01em;
        font-weight: 500;
      }
      nav {
        display: flex;
        gap: 2rem;
        align-items: center;
      }
      nav a {
        color: var(--text-muted);
        font-size: 0.9rem;
        letter-spacing: 0.02em;
        transition: color 0.2s ease;
      }
      nav a:hover {
        color: var(--accent-soft);
      }
      nav a.admin-link {
        display: inline-flex;
        align-items: center;
        opacity: 0.5;
        transition:
          opacity 0.2s ease,
          color 0.2s ease;
      }
      nav a.admin-link:hover {
        opacity: 1;
        color: var(--accent-soft);
      }
      .site-footer {
        border-top: 1px solid rgba(212, 168, 83, 0.1);
        padding: 2.5rem 0;
        text-align: center;
        color: var(--text-muted);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }
      .footer-tagline {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 1rem;
        color: var(--accent-soft);
        margin-bottom: 1rem;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
        line-height: 1.5;
      }
      .footer-admin {
        margin-top: 0.8rem;
        font-size: 0.7rem;
        opacity: 0.5;
        transition: opacity 0.2s ease;
      }
      .footer-admin:hover {
        opacity: 0.9;
      }
      .footer-admin a {
        color: var(--text-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .footer-admin a:hover {
        color: var(--accent-soft);
      }
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          gap: 0.6rem;
          padding-top: 0.9rem;
          padding-bottom: 0.9rem;
        }
        .logo {
          font-size: 1.15rem;
        }
        nav {
          gap: 0.9rem;
          flex-wrap: wrap;
          justify-content: center;
        }
        nav a {
          font-size: 0.8rem;
        }
        .site-footer {
          padding: 2rem 0;
          font-size: 0.75rem;
        }
        .footer-tagline {
          font-size: 0.9rem;
        }
      }
    </style>
  </body>
</html>
